@model SIARAWEB.Models.AcademicTracking

@{
    var subject = (SIARAWEB.Models.Subject)ViewBag.Subject;
    var task = (SIARAWEB.Models.DocumentTask)ViewBag.Task;
    ViewData["Title"] = "Captura de Seguimiento";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin-bottom: 0;">
                <i class="bi bi-bar-chart-steps me-2"></i> SEGUIMIENTO ACADÉMICO - @subject.Code
            </h3>
            <p class="text-muted fw-bold mb-0">
                Asignatura: <strong class="text-dark">@subject.Name</strong> |
                Fase: <span class="badge bg-primary">@task.PhaseType</span>
            </p>
        </div>
        <a asp-controller="DocumentTasks" asp-action="DocenteTasks" class="btn btn-outline-secondary fw-bold px-4 py-2" style="border-radius: 8px;">
            <i class="bi bi-arrow-left me-1"></i> Regresar a Mis Tareas
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold text-center shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show fw-bold text-center shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Panel de Captura -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header text-white py-3 px-4" style="background-color: #112d60;">
                    <h6 class="m-0 fw-bold text-uppercase">
                        <i class="bi bi-pencil-square me-2" style="color: #f4a915;"></i> Nueva Captura por Unidad
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Capture" method="post" id="trackingForm">
                        <input type="hidden" asp-for="SubjectId" />
                        <input type="hidden" asp-for="DocumentTaskId" />

                        <div class="mb-3">
                            <label class="fw-bold small text-muted">FASE DE SEGUIMIENTO</label>
                            <input type="text" class="form-control fw-bold bg-light" value="@task.PhaseType - @task.Title" disabled />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold small text-muted">TEMA / UNIDAD</label>
                            <input asp-for="UnitNumber" type="number" class="form-control fw-bold text-center bg-light" readonly />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="fw-bold small text-dark">TOTAL ALUMNOS</label>
                                <input asp-for="TotalStudents" id="txtTotal" type="number" min="1" class="form-control text-center fw-bold" required />
                            </div>
                            <div class="col-6">
                                <label class="fw-bold small text-success">APROBADOS</label>
                                <input asp-for="ApprovedStudents" id="txtApproved" type="number" min="0" class="form-control text-center text-success fw-bold" required />
                            </div>
                            <div class="col-6">
                                <label class="fw-bold small text-danger">REPROBADOS</label>
                                <input asp-for="FailedStudents" id="txtFailed" type="number" min="0" class="form-control text-center text-danger fw-bold" required />
                            </div>
                            <div class="col-6">
                                <label class="fw-bold small text-muted">DESERTORES</label>
                                <input asp-for="DroppedStudents" id="txtDropped" type="number" min="0" class="form-control text-center fw-bold" required />
                            </div>
                        </div>

                        <!-- ALERTA Y CAMPO DINÁMICO DE ACCIÓN CORRECTIVA (>= 40% REPROBACIÓN) -->
                        <div id="seccionAccionCorrectiva" class="mb-3 d-none">
                            <div class="alert alert-warning py-2 px-3 border-start border-4 border-warning mb-2" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong id="lblPorcentajeReprobacion">Reprobación: 0%</strong>
                                <div style="font-size: 12px;" class="mt-1">
                                    Por norma institucional, al alcanzar o superar el 40% de reprobación es obligatorio registrar la acción correctiva.
                                </div>
                            </div>

                            <label class="fw-bold text-danger small">ACCIÓN CORRECTIVA A IMPLEMENTAR</label>
                            <textarea asp-for="Observations" id="txtObservations" class="form-control" rows="3"
                                      placeholder="Describa la estrategia (ej. asesorías extraordinarias, talleres de reforzamiento, etc.)..."></textarea>
                            <span asp-validation-for="Observations" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn w-100 py-2 fw-bold mt-2 shadow-sm" style="background-color: #f4a915; color: #112d60; border-radius: 8px;">
                            <i class="bi bi-check-circle-fill me-1"></i> Guardar Rendimiento
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tabla de Resultados -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header text-white py-3 px-4" style="background-color: #112d60;">
                    <h6 class="m-0 fw-bold text-uppercase">
                        <i class="bi bi-table me-2" style="color: #f4a915;"></i> Estadísticas de Rendimiento Registradas
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle text-center mb-0" style="font-size: 13px;">
                            <thead style="background-color: #f2f3f5; color: #112d60; font-weight: 900; text-transform: uppercase;">
                                <tr>
                                    <th class="ps-3" style="width: 14%;">FASE</th>
                                    <th style="width: 10%;">TEMA</th>
                                    <th style="width: 13%;" class="text-success">ACREDITACIÓN</th>
                                    <th style="width: 13%;" class="text-danger">REPROBACIÓN</th>
                                    <th style="width: 10%;" class="text-muted">DESERCIÓN</th>
                                    <th style="width: 18%;">ACCIÓN CORRECTIVA</th>
                                    <th style="width: 12%;">JEFATURA</th>
                                    <th style="width: 10%;">ACCIONES</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (subject.AcademicTrackings == null || !subject.AcademicTrackings.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="py-5 text-muted fw-bold">
                                            <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                            Aún no hay temas registrados para esta asignatura.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var track in subject.AcademicTrackings.OrderBy(t => t.UnitNumber))
                                    {
                                        <tr class="fw-bold">
                                            <td class="text-primary ps-3">
                                                @(track.DocumentTask?.PhaseType ?? "-")
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">Tema @track.UnitNumber</span>
                                            </td>
                                            <td class="text-success">@track.ApprovalPercentage.ToString("F1")%</td>
                                            <td class="text-danger">@track.FailurePercentage.ToString("F1")%</td>
                                            <td class="text-muted">@track.DropoutPercentage.ToString("F1")%</td>

                                            <!-- Acción Correctiva con Modal Desplegable -->
                                            <td>
                                                @if (track.FailurePercentage >= 40)
                                                {
                                                    if (!string.IsNullOrWhiteSpace(track.Observations))
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary fw-bold px-2 py-1"
                                                                style="font-size: 11px; border-radius: 6px;"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalAccion_@track.Id"
                                                                title="Ver acción correctiva">
                                                            <i class="bi bi-eye-fill me-1"></i> Ver Plan
                                                        </button>

                                                        <!-- Modal -->
                                                        <div class="modal fade" id="modalAccion_@track.Id" tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog modal-dialog-centered">
                                                                <div class="modal-content text-start border-0 shadow">
                                                                    <div class="modal-header text-white" style="background-color: #112d60;">
                                                                        <h6 class="modal-title fw-bold">
                                                                            <i class="bi bi-tools text-warning me-2"></i> Acción Correctiva - Tema @track.UnitNumber
                                                                        </h6>
                                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                                    </div>
                                                                    <div class="modal-body p-3 bg-light">
                                                                        <div class="p-3 bg-white border rounded shadow-sm">
                                                                            <span class="text-muted small d-block mb-2">Estrategia registrada para reducir la reprobación (@track.FailurePercentage.ToString("F1")%):</span>
                                                                            <p class="text-dark m-0" style="white-space: pre-wrap; font-weight: normal; font-size: 13px;">@track.Observations</p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer bg-light p-2">
                                                                        <button type="button" class="btn btn-sm btn-secondary fw-bold px-3" data-bs-dismiss="modal">Cerrar</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger text-wrap" style="font-size: 10px;">SIN ACCIÓN REGISTRADA</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted fw-normal" style="font-size: 11px;">N/A (&lt; 40%)</span>
                                                }
                                            </td>

                                            <td>
                                                @if (track.ApprovalStatus == "Aprobado")
                                                {
                                                    <span class="badge bg-success">APROBADO</span>
                                                }
                                                else if (track.ApprovalStatus == "Rechazado")
                                                {
                                                    <span class="badge bg-danger" title="@track.Feedback">RECHAZADO</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">PENDIENTE</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="Delete" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@track.Id" />
                                                    <input type="hidden" name="subjectId" value="@subject.Id" />
                                                    <input type="hidden" name="taskId" value="@task.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" title="Eliminar registro" onclick="return confirm('¿Eliminar registro del tema?');">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const txtTotal = document.getElementById("txtTotal");
            const txtFailed = document.getElementById("txtFailed");
            const contenedorAccion = document.getElementById("seccionAccionCorrectiva");
            const txtObservations = document.getElementById("txtObservations");
            const lblPorcentaje = document.getElementById("lblPorcentajeReprobacion");

            function evaluarReprobacion() {
                const total = parseFloat(txtTotal.value) || 0;
                const reprobados = parseFloat(txtFailed.value) || 0;

                if (total > 0) {
                    const porcentajeReprobados = (reprobados / total) * 100;

                    if (porcentajeReprobados >= 40) {
                        lblPorcentaje.innerText = "Reprobación: " + porcentajeReprobados.toFixed(1) + "% (>= 40%)";
                        contenedorAccion.classList.remove("d-none");
                        txtObservations.setAttribute("required", "required");
                    } else {
                        contenedorAccion.classList.add("d-none");
                        txtObservations.removeAttribute("required");
                        txtObservations.value = "";
                    }
                } else {
                    contenedorAccion.classList.add("d-none");
                    txtObservations.removeAttribute("required");
                }
            }

            txtTotal.addEventListener("input", evaluarReprobacion);
            txtFailed.addEventListener("input", evaluarReprobacion);
            evaluarReprobacion();
        });
    </script>
}

