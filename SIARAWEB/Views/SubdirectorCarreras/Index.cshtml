@model IEnumerable<SIARAWEB.Models.Departamento>

@{
    ViewData["Title"] = "Carreras Institucionales";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin: 0;">
                <i class="bi bi-buildings-fill me-2"></i> SUPERVISIÓN DE CARRERAS Y DEPARTAMENTOS
            </h3>
            <p class="text-muted fw-bold mt-1 mb-0">Seleccione un departamento para auditar su calendario de cortes y materias.</p>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var depto in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; border-left: 5px solid #112d60 !important;">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <span class="badge bg-secondary mb-2">@depto.Code</span>
                            <h5 class="fw-bold text-dark">@depto.Name</h5>
                            <p class="text-muted small mb-3">Asignaturas registradas: @(depto.Subjects?.Count ?? 0)</p>
                        </div>
                        <a asp-action="Details" asp-route-id="@depto.Id" class="btn btn-outline-primary fw-bold w-100" style="border-radius: 8px;">
                            <i class="bi bi-eye-fill me-1"></i> Ver Fechas de Corte y Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>