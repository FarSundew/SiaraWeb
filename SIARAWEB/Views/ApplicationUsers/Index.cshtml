@model IEnumerable<SIARAWEB.Models.ApplicationUser>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin-bottom: 0;">
                <i class="bi bi-person-badge-fill me-2"></i> PLANTILLA Y USUARIOS DEL SISTEMA
            </h3>
            <p class="text-muted fw-bold m-0">Administración general de cuentas institucionales y roles de acceso.</p>
        </div>
        <a asp-action="Create" class="btn text-white fw-bold px-4 py-2 shadow-sm" style="background-color: #112d60; border-radius: 8px;">
            <i class="bi bi-person-plus-fill me-2" style="color: #f4a915;"></i> Nuevo Usuario
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold text-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show fw-bold text-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center" style="background-color: #112d60; color: white;">
            <h5 class="mb-0 fw-bold" style="font-size: 15px; text-transform: uppercase;">
                <i class="bi bi-people-fill me-2" style="color: #f4a915;"></i> Cuentas Institucionales Registradas
            </h5>
            <span class="badge bg-light text-dark fw-bold px-3 py-1">@Model.Count() Usuario(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f2f3f5; color: #112d60; font-weight: 900;">
                        <tr>
                            <th class="py-3 px-4">NOMBRE COMPLETO</th>
                            <th class="py-3 px-4">CORREO INSTITUCIONAL</th>
                            <th class="py-3 px-4">RFC</th>
                            <th class="py-3 px-4">CURP</th>
                            <th class="py-3 px-4 text-center">ESTADO</th>
                            <th class="py-3 px-4 text-end">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-dark">@item.FullName</td>
                                <td class="px-4 text-muted">@item.Email</td>
                                <td class="px-4">@(string.IsNullOrEmpty(item.RFC) ? "N/A" : item.RFC)</td>
                                <td class="px-4">@(string.IsNullOrEmpty(item.CURP) ? "N/A" : item.CURP)</td>
                                <td class="px-4 text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success px-3 py-2" style="border-radius: 20px;">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-15 text-danger px-3 py-2" style="border-radius: 20px;">Bloqueado</span>
                                    }
                                </td>

                                <td class="px-4 text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-bold me-1" title="Editar datos">
                                        <i class="bi bi-pencil-fill"></i> Editar
                                    </a>
                                    @if (item.IsActive && (item.LockoutEnd == null || item.LockoutEnd <= DateTimeOffset.UtcNow))
                                    {
                                        <form asp-action="LockAccount" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" title="Bloquear cuenta" onclick="return confirm('¿Estás seguro de bloquear el acceso a este usuario?');">
                                                <i class="bi bi-lock-fill"></i> Bloquear
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="UnlockAccount" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold" title="Desbloquear cuenta" onclick="return confirm('¿Estás seguro de reactivar este usuario?');">
                                                <i class="bi bi-unlock-fill"></i> Desbloquear
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
