@{
    ViewData["Title"] = "Inicio";
    bool isDocente = User.IsInRole("Docente") || User.IsInRole("JefeCarrera");
    bool esJefeCarrera = User.IsInRole("JefeCarrera") && !User.IsInRole("JefeGeneral") && !User.IsInRole("Administrador");
    bool isJefeOrAdmin = User.IsInRole("JefeCarrera") || User.IsInRole("JefeGeneral") || User.IsInRole("Administrador");
}

<div class="container-fluid mt-2">
    <!-- HERO SECTION -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-5 text-white shadow-sm" style="background: linear-gradient(135deg, #112d60 0%, #1a458f 100%); border-radius: 15px; position: relative; overflow: hidden;">
                <div style="position: relative; z-index: 2;">
                    <h2 class="fw-bold display-6 mb-2">¡Bienvenido, @ViewBag.UserFullName!</h2>
                    <p class="lead mb-0 opacity-75">Sistema Integral de Análisis y Reportes Académicos</p>
                    <div class="mt-4">
                        <span class="badge bg-white text-dark py-2 px-3 fw-bold shadow-sm" style="font-size: 0.9rem; border-radius: 20px;">
                            <i class="bi bi-calendar3 me-2 text-primary"></i> Periodo Actual: @ViewBag.ActivePeriodName
                        </span>
                    </div>
                </div>
                <i class="bi bi-grid-1x2-fill" style="position: absolute; right: -20px; bottom: -40px; font-size: 15rem; opacity: 0.05; transform: rotate(-15deg);"></i>
            </div>
        </div>
    </div>

    <!-- ACCESOS RÁPIDOS PRINCIPALES -->
    <div class="row mb-5">
        <div class="col-12">
            <h5 class="fw-bold mb-3" style="color: #112d60; border-bottom: 2px solid #e9ecef; padding-bottom: 10px;">
                <i class="bi bi-rocket-takeoff-fill me-2"></i>Accesos Rápidos
            </h5>
        </div>

        @if (isDocente)
        {
            <div class="col-md-4 mb-3">
                <a asp-controller="DocumentTasks" asp-action="DocenteTasks" class="text-decoration-none">
                    <div class="card border-0 shadow-sm hover-card h-100 p-4" style="border-radius: 12px; border-top: 5px solid #dc3545 !important; background-color: #fff;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                                <i class="bi bi-file-earmark-arrow-up-fill fs-2 text-danger"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Mis Buzones / Tareas</h5>
                                <p class="text-muted small mb-0">Sube documentos y captura tus calificaciones aquí.</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (isJefeOrAdmin)
        {
            <div class="col-md-4 mb-3">
                <a asp-controller="DocumentTasks" asp-action="Index" class="text-decoration-none">
                    <div class="card border-0 shadow-sm hover-card h-100 p-4" style="border-radius: 12px; border-top: 5px solid #ffc107 !important; background-color: #fff;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                                <i class="bi bi-ui-checks-grid fs-2 text-warning"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Mesa de Revisión</h5>
                                <p class="text-muted small mb-0">Dictamina los archivos y calificaciones recibidas.</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-md-4 mb-3">
                <a asp-controller="Reports" asp-action="Index" class="text-decoration-none">
                    <div class="card border-0 shadow-sm hover-card h-100 p-4" style="border-radius: 12px; border-top: 5px solid #198754 !important; background-color: #fff;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                <i class="bi bi-traffic-light-fill fs-2 text-success"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Auditoría y Semáforo</h5>
                                <p class="text-muted small mb-0">Consulta el índice de cumplimiento general y métricas.</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- INDICADORES -->
    <div class="row">
        @if (isDocente)
        {
            <div class="col-12">
                <h5 class="fw-bold mb-3" style="color: #112d60; border-bottom: 2px solid #e9ecef; padding-bottom: 10px;">
                    <i class="bi bi-person-workspace me-2"></i>Mi Carga Académica (@ViewBag.ActivePeriodName)
                </h5>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary me-3">
                            <i class="bi bi-book-fill fs-3"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Grupos Asignados</h6>
                            <h2 class="fw-bold m-0 text-dark">@ViewBag.MySubjectsCount</h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info me-3">
                            <i class="bi bi-file-earmark-check-fill fs-3"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Documentos Subidos</h6>
                            <h2 class="fw-bold m-0 text-dark">@ViewBag.MyDocsCount</h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success me-3">
                            <i class="bi bi-graph-up-arrow fs-3"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Acreditación Promedio</h6>
                            <h2 class="fw-bold m-0 text-success">@ViewBag.MyAvgApproval%</h2>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (isJefeOrAdmin)
        {
            <div class="col-12 mt-2">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="fw-bold mb-0" style="color: #112d60;">
                        <i class="bi bi-speedometer2 me-2"></i>Indicadores de Dirección
                    </h5>
                    <span class="badge bg-light text-secondary border border-secondary rounded-pill px-3 py-1">
                        <i class="bi bi-geo-alt-fill me-1"></i> @(esJefeCarrera ? $"Carrera: {ViewBag.NombreCarrera}" : "Cobertura Institucional")
                    </span>
                </div>
            </div>
            
            <div class="col-md-3 mb-4">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                    <div class="d-flex flex-column align-items-center text-center">
                        <i class="bi bi-people-fill fs-1 mb-2" style="color: #112d60;"></i>
                        <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.7rem;">Docentes Activos</h6>
                        <h2 class="fw-bold m-0 text-dark">@ViewBag.TotalDocentes</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                    <div class="d-flex flex-column align-items-center text-center">
                        <i class="bi bi-journal-text fs-1 mb-2 text-info"></i>
                        <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.7rem;">Total Materias</h6>
                        <h2 class="fw-bold m-0 text-dark">@ViewBag.TotalAsignaturas</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                    <div class="d-flex flex-column align-items-center text-center">
                        <i class="bi bi-building-fill fs-1 mb-2 text-primary"></i>
                        <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.7rem;">Áreas / Carreras</h6>
                        <h2 class="fw-bold m-0 text-dark">@ViewBag.TotalDepartamentos</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                    <div class="d-flex flex-column align-items-center text-center">
                        <i class="bi bi-pie-chart-fill fs-1 mb-2 text-success"></i>
                        <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.7rem;">Acreditación Global</h6>
                        <h2 class="fw-bold m-0 text-success">@ViewBag.GlobalApproval%</h2>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>