

@inject Microsoft.AspNetCore.Identity.UserManager<SIARAWEB.Models.ApplicationUser> UserManager
@inject SIARAWEB.Data.ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIARA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body style="margin: 0; padding: 0; background-color: #f2f3f5; overflow-x: hidden;">

    <header class="siara-header" style="background-color: #112d60; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1); position: sticky; top: 0; z-index: 1000; width: 100%;">
        <div style="display: flex; align-items: center; gap: 15px;">
            <img src="~/img/tecnm_logo.png" alt="TecNM" style="height: 55px;" />
            <div class="siara-header-text d-none d-md-block" style="text-align: left;">
                <h4 style="color: white; margin: 0; font-weight: 900; font-size: 1.1rem;">TECNOLÓGICO NACIONAL DE MÉXICO</h4>
                <h6 style="color: #d1d5db; margin: 0; font-size: 0.85rem;">Sistema Integral de Análisis y Reportes Académicos</h6>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 20px;">
            @if (User.Identity?.IsAuthenticated == true)
            {
                
    var currentUser = await UserManager.GetUserAsync(User);
    int unreadCount = 0;
    List<SIARAWEB.Models.Notification> importantNotifs = new List<SIARAWEB.Models.Notification>();
    List<SIARAWEB.Models.Notification> normalNotifs = new List<SIARAWEB.Models.Notification>();
    if (currentUser != null) {
        var allNotifs = DbContext.Notifications.Where(n => n.UserId == currentUser.Id).OrderByDescending(n => n.CreatedAt).ToList();
        unreadCount = allNotifs.Count(n => !n.IsRead);
        importantNotifs = allNotifs.Where(n => n.Type == "Importante").Take(5).ToList();
        normalNotifs = allNotifs.Where(n => n.Type == "Normal").Take(5).ToList();
    }
                <div class="dropdown">
                    <button class="btn btn-link text-white text-decoration-none dropdown-toggle" type="button" id="bellDropdown" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside" style="position: relative;">
                        <i class="bi bi-bell-fill fs-5"></i>
                        @if(unreadCount > 0) {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem; margin-top: 5px; margin-left: -10px;">
                                @unreadCount
                            </span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="bellDropdown" style="min-width: 350px; border-radius: 12px; padding: 0; overflow: hidden;">
                        <li class="px-3 py-2 fw-bold border-bottom bg-light text-primary d-flex justify-content-between align-items-center">
                            Notificaciones
                            <ul class="nav nav-pills" id="pills-tab" role="tablist" style="font-size: 0.8rem;">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active py-0 px-2" id="pills-important-tab" data-bs-toggle="pill" data-bs-target="#pills-important" type="button" role="tab">Importantes</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link py-0 px-2" id="pills-normal-tab" data-bs-toggle="pill" data-bs-target="#pills-normal" type="button" role="tab">Normales</button>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <div class="tab-content" id="pills-tabContent" style="max-height: 400px; overflow-y: auto;">
                                <div class="tab-pane fade show active" id="pills-important" role="tabpanel" tabindex="0">
                                    @if (!importantNotifs.Any()) {
                                        <div class="px-3 py-4 text-center text-muted small"><i class="bi bi-bell-slash fs-4 d-block mb-2"></i>No hay nuevas tareas o fechas.</div>
                                    }
                                    @foreach(var notif in importantNotifs) {
                                        <a class="dropdown-item py-2 px-3 border-bottom @(notif.IsRead ? "" : "fw-bold bg-light")" href="@Url.Action("MarkNotificationRead", "Home", new { id = notif.Id, returnUrl = notif.ActionUrl })" style="white-space: normal; line-height: 1.2;">
                                            <div style="font-size: 0.85rem;" class="text-wrap">@notif.Message</div>
                                            <div class="text-muted mt-1" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>@notif.CreatedAt.ToString("dd/MMM HH:mm")</div>
                                        </a>
                                    }
                                </div>
                                <div class="tab-pane fade" id="pills-normal" role="tabpanel" tabindex="0">
                                    @if (!normalNotifs.Any()) {
                                        <div class="px-3 py-4 text-center text-muted small"><i class="bi bi-bell-slash fs-4 d-block mb-2"></i>No hay actualizaciones de entregas.</div>
                                    }
                                    @foreach(var notif in normalNotifs) {
                                        <a class="dropdown-item py-2 px-3 border-bottom @(notif.IsRead ? "" : "fw-bold bg-light")" href="@Url.Action("MarkNotificationRead", "Home", new { id = notif.Id, returnUrl = notif.ActionUrl })" style="white-space: normal; line-height: 1.2;">
                                            <div style="font-size: 0.85rem;" class="text-wrap">@notif.Message</div>
                                            <div class="text-muted mt-1" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>@notif.CreatedAt.ToString("dd/MMM HH:mm")</div>
                                        </a>
                                    }
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="dropdown">
                    <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2"
                            type="button"
                            id="perfilDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            style="border-radius: 20px; padding: 6px 16px; border-color: rgba(255,255,255,0.4); transition: all 0.3s ease;">
                        <i class="bi bi-person-circle fs-5"></i>
                        <span style="font-weight: 600; font-size: 0.9rem;">Mi Cuenta</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="perfilDropdown" style="min-width: 240px; border-radius: 12px; margin-top: 12px; padding: 0; overflow: hidden; border: 1px solid #e5e7eb;">

                        <li class="px-4 py-3 border-bottom" style="background-color: #f8fafc;">
                            <div style="font-size: 0.75rem; color: #6b7280; text-transform: uppercase; font-weight: bold; margin-bottom: 3px;">Conectado como:</div>
                            <strong class="text-dark d-block text-truncate" style="font-size: 0.95rem;">@User.Identity.Name</strong>
                        </li>

                        <li class="mt-2">
                            <a class="dropdown-item d-flex align-items-center gap-3 py-2 px-4 hover-bg-light" asp-area="Identity" asp-page="/Account/Manage/Index" style="transition: background-color 0.2s;">
                                <i class="bi bi-gear-fill text-primary fs-5"></i>
                                <span style="font-weight: 500; color: #374151;">Ajustes de Cuenta</span>
                            </a>
                        </li>

                        <li><hr class="dropdown-divider my-2" style="border-color: #e5e7eb;"></li>

                        <li class="mb-2">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="margin: 0;">
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-3 py-2 px-4 hover-bg-light text-danger">
                                    <i class="bi bi-box-arrow-right fs-5"></i>
                                    <span style="font-weight: bold;">Cerrar Sesión</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            <img src="~/img/instituto_logo.png" alt="ITC" style="height: 55px;" />
        </div>
    </header>

    <div style="display: flex; min-height: calc(100vh - 75px);">

        @if (ViewData["Title"]?.ToString() != "Iniciar Sesión" && User.Identity?.IsAuthenticated == true)
        {
            <div style="width: 260px; min-width: 260px; background-color: #112d60; box-shadow: 2px 0 5px rgba(0,0,0,0.1); z-index: 900;">
                <partial name="_Sidebar" />
            </div>
        }

        <main role="main" style="flex: 1; padding: 40px 30px; background-color: #f2f3f5; width: 100%;">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



