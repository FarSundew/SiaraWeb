<div class="sidebar-sticky" style="padding-top: 30px;">
    <h6 class="text-center mb-4" style="color: #ffffff; font-weight: 900; letter-spacing: 1.5px;">MENÚ PRINCIPAL</h6>
    <hr style="border-top: 2px solid #ffffff; margin: 0 20px 20px 20px; opacity: 0.3;" />

    <ul class="nav flex-column" style="gap: 8px; padding: 0 15px;">

        <li class="nav-item">
            <a class="nav-link fw-bold siara-nav-link" asp-controller="Home" asp-action="Index">
                🏠 INICIO
            </a>
        </li>

        <!-- 👨‍🏫 DOCENTES (Y Jefes de Carrera que dan clases) -->
        @if (User.IsInRole("Docente") || User.IsInRole("JefeCarrera"))
        {
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="DocumentTasks" asp-action="DocenteTasks">
                    <i class="bi bi-clipboard-check me-2"></i> MIS TAREAS / ENTREGAS
                </a>

            </li>
        }

        <!-- 👔 JEFE DE CARRERA -->
        @if (User.IsInRole("JefeCarrera"))
        {
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="Subjects" asp-action="Index">
                    📚 ASIGNATURAS
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="Docentes" asp-action="Index">
                    👨‍🏫 PLANTILLA DOCENTE
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="Reports" asp-action="Index">
                    🚥 SEMÁFORO ENTREGAS
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="DocumentTasks" asp-action="Index">
                    ⏳ BUZONES / TAREAS
                </a>
            </li>

        }

        <!-- 👑 JEFE GENERAL / SUBDIRECTOR -->
        @if (User.IsInRole("JefeGeneral"))
        {
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="DashboardGeneral" asp-action="Index">
                    🧭 MAPA INSTITUCIONAL
                </a>
            </li>
            

        }

        <!-- 🛠️ ADMINISTRADOR -->
        @if (User.IsInRole("Administrador"))
        {
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="ApplicationUsers" asp-action="Index">
                    👥 GESTIÓN DE USUARIOS
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="Departamentos" asp-action="Index">
                    🏢 DEPARTAMENTOS Y CARRERAS
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link fw-bold siara-nav-link" asp-controller="Backup" asp-action="Index">
                    💾 RESPALDO BD
                </a>
            </li>

        }

    </ul>
</div>

<style>
    .siara-nav-link {
        color: #ffffff !important;
        font-size: 14px;
        padding: 12px 20px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .siara-nav-link:hover {
            background-color: #f4a915 !important;
            color: #112d60 !important;
        }
</style>

