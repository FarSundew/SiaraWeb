@model SIARAWEB.ViewModels.FinalReportConsolidatedViewModel

@{
    ViewData["Title"] = "Reporte Final y Cierre de Materia";
    var docente = Model.Subject.DocenteAsignaturas?.FirstOrDefault()?.Docente?.FullName ?? "Sin Asignar";
}

<div class="container-fluid mt-4">
    <!-- Encabezado y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin: 0;">
                <i class="bi bi-mortarboard-fill me-2"></i> REPORTE FINAL Y CIERRE DE ASIGNATURA
            </h3>
            <p class="text-muted fw-bold mt-1 mb-0">Consolidado semestral de unidades evaluadas, regularizaciones e índices definitivos.</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print();" class="btn btn-outline-dark fw-bold">
                <i class="bi bi-printer-fill me-1"></i> Imprimir Reporte
            </button>
            <a asp-controller="AcademicTrackings" asp-action="Index" class="btn btn-outline-secondary fw-bold">
                Regresar
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold text-center shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <!-- Ficha Técnica de la Materia -->
    <div class="card shadow-sm border-0 mb-4 p-3 bg-light border-start border-4 border-primary">
        <div class="row g-2 align-items-center">
            <div class="col-md-3"><strong>Clave:</strong> @Model.Subject.Code</div>
            <div class="col-md-4"><strong>Materia:</strong> @Model.Subject.Name</div>
            <div class="col-md-3"><strong>Docente:</strong> @docente</div>
            <div class="col-md-2"><strong>Periodo:</strong> @(Model.Subject.AcademicPeriod?.Name ?? "-")</div>
        </div>
    </div>

    <!-- 1. Tabla de Unidades Evaluadas (Historial Semestral) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white fw-bold py-3" style="background-color: #112d60;">
            <i class="bi bi-journal-text me-2"></i> 1. RENDIMIENTO PARCIAL POR UNIDAD EVALUADA (TX)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size: 13px;">
                    <thead style="background-color: #f2f3f5; color: #112d60; font-weight: 900;">
                        <tr>
                            <th style="width: 15%;">TEMA / UNIDAD</th>
                            <th style="width: 20%;">FASE CORRESPONDIENTE</th>
                            <th style="width: 15%;">TOTAL EVALUADOS</th>
                            <th style="width: 15%;" class="text-success">% APROBACIÓN</th>
                            <th style="width: 15%;" class="text-danger">% REPROBACIÓN</th>
                            <th style="width: 20%;">ACCIÓN CORRECTIVA REGISTRADA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UnitTrackings.Any())
                        {
                            <tr>
                                <td colspan="6" class="py-3 text-muted fw-bold">No se registraron unidades en los seguimientos parciales.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var u in Model.UnitTrackings)
                            {
                                <tr>
                                    <td class="fw-bold">Tema @u.UnitNumber</td>
                                    <td>@(u.CutoffDate?.Name ?? "Seguimiento")</td>
                                    <td class="fw-bold">@u.TotalStudents</td>
                                    <td class="fw-bold text-success">@u.ApprovalPercentage.ToString("F1")%</td>
                                    <td class="fw-bold text-danger">@u.FailurePercentage.ToString("F1")%</td>
                                    <td class="text-start small">@(string.IsNullOrWhiteSpace(u.Observations) ? "N/A" : u.Observations)</td>
                                </tr>
                            }
                            <tr style="background-color: #f8f9fa; font-weight: bold;">
                                <td colspan="3" class="text-end">PROMEDIO ACUMULADO TEMAS:</td>
                                <td class="text-success">@Model.UnitsAverageApproval.ToString("F1")%</td>
                                <td class="text-danger">@Model.UnitsAverageFailure.ToString("F1")%</td>
                                <td class="text-muted small">Promedios parciales</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. Formulario de Cierre Definitivo con Segundas Oportunidades -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white fw-bold py-3" style="background-color: #112d60;">
            <i class="bi bi-calculator me-2"></i> 2. CIERRE DEFINITIVO DEL GRUPO (POSTERIOR A REGULARIZACIONES)
        </div>
        <div class="card-body p-4">
            <form asp-action="SaveFinalGrades" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SubjectId" value="@Model.Subject.Id" />
                <input type="hidden" name="CutoffDateId" value="@(Model.CutoffDateFinal?.Id ?? 0)" />

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">TOTAL ALUMNOS INSCRITOS</label>
                        <input type="number" name="TotalStudents" class="form-control fw-bold fs-5 text-center"
                               value="@Model.FinalGrade.TotalStudents" min="1" required @(Model.IsReadOnly ? "disabled" : "") />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-success">APROBADOS EN ORDINARIO</label>
                        <input type="number" name="ApprovedRegularStudents" class="form-control fw-bold text-success text-center"
                               value="@Model.FinalGrade.ApprovedRegularStudents" min="0" required @(Model.IsReadOnly ? "disabled" : "") />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-primary">APROBADOS EN 2DA OPORTUNIDAD</label>
                        <input type="number" name="ApprovedMakeupStudents" class="form-control fw-bold text-primary text-center"
                               value="@Model.FinalGrade.ApprovedMakeupStudents" min="0" required @(Model.IsReadOnly ? "disabled" : "") />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-danger">REPROBADOS DEFINITIVOS</label>
                        <input type="number" name="FinalFailedStudents" class="form-control fw-bold text-danger text-center"
                               value="@Model.FinalGrade.FinalFailedStudents" min="0" required @(Model.IsReadOnly ? "disabled" : "") />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">DESERTORES FINALES</label>
                        <input type="number" name="FinalDroppedStudents" class="form-control fw-bold text-secondary text-center"
                               value="@Model.FinalGrade.FinalDroppedStudents" min="0" required @(Model.IsReadOnly ? "disabled" : "") />
                    </div>
                    <div class="col-md-9">
                        <label class="form-label fw-bold small text-muted">OBSERVACIONES GENERALES DE CIERRE</label>
                        <input type="text" name="Observations" class="form-control"
                               value="@Model.FinalGrade.Observations" placeholder="Incidencias finales, acuerdos de academia o notas de acreditación..." @(Model.IsReadOnly ? "disabled" : "") />
                    </div>
                </div>

                <!-- Indicadores Calculados -->
                @if (Model.FinalGrade.TotalStudents > 0)
                {
                    <div class="row g-3 p-3 bg-light rounded text-center mb-4">
                        <div class="col-md-4">
                            <span class="text-muted fw-bold small">ACREDITACIÓN FINAL (ORD + REG):</span>
                            <h4 class="text-success fw-bold mb-0">@Model.FinalGrade.FinalApprovalPercentage%</h4>
                            <small class="text-muted">(@Model.FinalGrade.FinalApprovedStudents alumnos)</small>
                        </div>
                        <div class="col-md-4">
                            <span class="text-muted fw-bold small">REPROBACIÓN FINAL:</span>
                            <h4 class="text-danger fw-bold mb-0">@Model.FinalGrade.FinalFailurePercentage%</h4>
                            <small class="text-muted">(@Model.FinalGrade.FinalFailedStudents alumnos)</small>
                        </div>
                        <div class="col-md-4">
                            <span class="text-muted fw-bold small">DESERCIÓN FINAL:</span>
                            <h4 class="text-secondary fw-bold mb-0">@Model.FinalGrade.FinalDropoutPercentage%</h4>
                            <small class="text-muted">(@Model.FinalGrade.FinalDroppedStudents alumnos)</small>
                        </div>
                    </div>
                }

                @if (!Model.IsReadOnly)
                {
                    <div class="text-end">
                        <button type="submit" class="btn btn-success fw-bold px-4 py-2">
                            <i class="bi bi-save me-1"></i> Guardar Cierre de Materia
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- 3. Evidencias Documentales Finales (Acta en PDF) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white fw-bold py-3" style="background-color: #112d60;">
            <i class="bi bi-file-earmark-pdf me-2"></i> 3. ACTA DE CALIFICACIONES Y DOCUMENTOS DE CIERRE
        </div>
        <div class="card-body">
            @if (!Model.FinalDocuments.Any())
            {
                <div class="alert alert-warning fw-bold mb-0">
                    <i class="bi bi-exclamation-circle me-1"></i> Aún no se ha cargado el Acta de Calificaciones en PDF.
                    @if (!Model.IsReadOnly)
                    {
                        <a asp-controller="Documents" asp-action="Upload" asp-route-id="@Model.Subject.Id" asp-route-faseSeleccionada="Final" class="ms-2 fw-bold text-dark text-decoration-underline">
                            Subir Acta Oficial aquí
                        </a>
                    }
                </div>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var doc in Model.FinalDocuments)
                    {
                        <li class="d-flex justify-content-between align-items-center list-group-item">
                            <div>
                                <strong>@doc.DocumentType</strong>
                                <small class="text-muted d-block">Entregado el: @doc.UploadedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div>
                                <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="bi bi-eye me-1"></i> Ver PDF Oficial
                                </a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>