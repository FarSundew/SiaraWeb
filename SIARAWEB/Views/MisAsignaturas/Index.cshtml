@model IEnumerable<SIARAWEB.Models.Subject>

@{
    ViewData["Title"] = "Mis Asignaturas";
    var periodoActivo = ViewBag.PeriodoActivo as SIARAWEB.Models.AcademicPeriod;
    var anteriorPeriodo = ViewBag.AnteriorPeriodo as SIARAWEB.Models.AcademicPeriod;
    var siguientePeriodo = ViewBag.SiguientePeriodo as SIARAWEB.Models.AcademicPeriod;
    var proximoCorte = ViewBag.ProximoCorte as SIARAWEB.Models.CutoffDate;
}

<div class="container-fluid mt-4">

    <!-- 🟢 NAVEGACIÓN ENTRE PERIODOS (FLECHAS) -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px; background-color: #112d60; color: white;">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">

            <!-- Flecha Izquierda (Periodos más antiguos) -->
            <div style="width: 150px; text-align: left;">
                @if (anteriorPeriodo != null)
                {
                    <a asp-action="Index" asp-route-periodoId="@anteriorPeriodo.Id" class="btn btn-outline-light btn-sm fw-bold border-0">
                        <i class="bi bi-chevron-left me-1"></i> Anterior
                    </a>
                }
            </div>

            <!-- Centro: Periodo Actual -->
            <div class="text-center flex-grow-1">
                <span class="text-uppercase small fw-bold" style="letter-spacing: 1px; color: #f4a915;">PERIODO ESCOLAR ACTUAL</span>
                <h4 class="m-0 fw-bold">@(periodoActivo?.Name ?? "Sin Periodo Activo")</h4>
            </div>

            <!-- Flecha Derecha (Periodos más nuevos) -->
            <div style="width: 150px; text-align: right;">
                @if (siguientePeriodo != null)
                {
                    <a asp-action="Index" asp-route-periodoId="@siguientePeriodo.Id" class="btn btn-outline-light btn-sm fw-bold border-0">
                        Siguiente <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                }
            </div>

        </div>
    </div>

    <!-- 🟢 AVISO DE FECHA DE CORTE (Solo para el periodo seleccionado) -->
    @if (proximoCorte != null)
    {
        <div class="alert alert-warning shadow-sm border-0 d-flex align-items-center mb-4" style="border-left: 5px solid #ffc107 !important;">
            <i class="bi bi-clock-history fs-3 me-3 text-warning"></i>
            <div>
                <h6 class="fw-bold mb-1 text-dark">FASE ACTIVA: @proximoCorte.Name.ToUpper()</h6>
                <p class="m-0 text-muted small">Cierre programado para el <strong>@proximoCorte.DueDate.ToString("dd/MMM/yyyy HH:mm")</strong>.</p>
            </div>
        </div>
    }

    <!-- 🟢 MATERIAS DEL PERIODO SELECCIONADO -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info text-center fw-bold shadow-sm border-0">
                    No tienes materias asignadas para este periodo escolar.
                </div>
            </div>
        }
        else
        {
            @foreach (var materia in Model)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 10px; border-bottom: 4px solid #f4a915 !important;">
                        <div class="card-body">
                            <h5 class="fw-bold text-dark mb-1">@materia.Name</h5>
                            <p class="text-muted small mb-3">Clave: <strong>@materia.Code</strong></p>

                            <!-- Botones que envían al maestro a subir documentos o calificaciones -->
                            <div class="d-flex gap-2">
                                <a asp-controller="Documents" asp-action="Upload" asp-route-id="@materia.Id" class="btn btn-sm btn-outline-primary fw-bold w-100" style="border-radius: 6px;">
                                    <i class="bi bi-folder-plus"></i> Documentos
                                </a>
                                @if (proximoCorte == null || proximoCorte.PhaseType != "Inicial")
                                {
                                    <a asp-controller="AcademicTrackings" asp-action="Capture" asp-route-id="@materia.Id" class="btn btn-sm btn-outline-success fw-bold w-100" style="border-radius: 6px;">
                                        <i class="bi bi-bar-chart"></i> Seguimiento
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>