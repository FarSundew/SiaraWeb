@model SIARAWEB.Models.CutoffDate

@{
    ViewData["Title"] = "Editar Fecha de Corte";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header text-white fw-bold py-3 px-4" style="background-color: #112d60;">
            <i class="bi bi-pencil-square me-2"></i> EDITAR FECHA DE CORTE Y PRÓRROGAS
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DepartamentoId" />

                <!-- Nombre (renderizado explícito para evitar ModelState override) -->
                <div class="mb-3">
                    <label for="Name" class="form-label fw-bold small text-muted">NOMBRE DEL CORTE</label>
                    <input name="Name" id="Name" class="form-control fw-bold" required value="@(Model?.Name ?? string.Empty)" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AcademicPeriodId" class="form-label fw-bold small text-muted">PERIODO ESCOLAR</label>
                    <select asp-for="AcademicPeriodId" class="form-select fw-bold" asp-items="ViewBag.AcademicPeriodId" required></select>
                    <span asp-validation-for="AcademicPeriodId" class="text-danger small"></span>
                </div>

                <!-- Tipo de fase -->
                <div class="mb-3">
                    <label asp-for="PhaseType" class="form-label fw-bold small text-muted">TIPO DE FASE</label>
                    <select asp-for="PhaseType" class="form-select fw-bold" required>
                        <option value="Inicial">Documentos Iniciales</option>
                        <option value="Seguimiento1">1er Seguimiento</option>
                        <option value="Seguimiento2">2do Seguimiento</option>
                        <option value="Final">Reporte Final</option>
                    </select>
                    <span asp-validation-for="PhaseType" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="StartDate" class="form-label fw-bold small text-muted">FECHA DE APERTURA</label>
                        <input name="StartDate"
                               id="StartDate"
                               type="datetime-local"
                               class="form-control fw-bold"
                               required
                               value="@(Model != null && Model.StartDate != DateTime.MinValue ? Model.StartDate.ToString("yyyy-MM-ddTHH:mm") : string.Empty)" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label for="DueDate" class="form-label fw-bold small text-muted">FECHA LÍMITE (PRÓRROGA)</label>
                        <input name="DueDate"
                               id="DueDate"
                               type="datetime-local"
                               class="form-control fw-bold text-danger"
                               required
                               value="@(Model != null && Model.DueDate != DateTime.MinValue ? Model.DueDate.ToString("yyyy-MM-ddTHH:mm") : string.Empty)" />
                        <span asp-validation-for="DueDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4" style="border-radius: 8px;">
                        Cancelar
                    </a>
                    <button type="submit" class="btn text-white fw-bold px-4" style="background-color: #f4a915; border-radius: 8px; color: #112d60 !important;">
                        <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}