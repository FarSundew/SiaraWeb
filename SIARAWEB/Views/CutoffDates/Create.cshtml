@model SIARAWEB.Models.CutoffDate

@{
    ViewData["Title"] = "Nueva Fecha de Corte";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header text-white fw-bold py-3" style="background-color: #112d60;">
            <i class="bi bi-calendar-plus me-2"></i> NUEVA FECHA DE CORTE
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold small text-muted">NOMBRE DEL CORTE</label>
                    <input asp-for="Name" class="form-control fw-bold" placeholder="Ej. 1er Seguimiento - Sistemas" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AcademicPeriodId" class="form-label fw-bold small text-muted">PERIODO ESCOLAR</label>
                    <select asp-for="AcademicPeriodId" class="form-select fw-bold" asp-items="ViewBag.AcademicPeriodId" required></select>
                </div>

                <div class="mb-3">
                    <label asp-for="PhaseType" class="form-label fw-bold small text-muted">TIPO DE FASE</label>
                    <select asp-for="PhaseType" class="form-select fw-bold" required>
                        <option value="Inicial">Documentos Iniciales</option>
                        <option value="Seguimiento1">1er Seguimiento</option>
                        <option value="Seguimiento2">2do Seguimiento</option>
                        <option value="Final">Reporte Final</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="DepartamentoId" class="form-label fw-bold small text-muted">DEPARTAMENTO / CARRERA</label>
                    <select asp-for="DepartamentoId" class="form-select fw-bold" asp-items="ViewBag.DepartamentoId">
                        <option value="">-- Toda la Institución (General) --</option>
                    </select>
                    <small class="text-muted">Si se deja vacío, aplica para toda la institución.</small>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label asp-for="StartDate" class="form-label fw-bold small text-muted">FECHA DE APERTURA</label>
                        <input asp-for="StartDate" type="datetime-local" class="form-control fw-bold" required />
                    </div>
                    <div class="col-6">
                        <label asp-for="DueDate" class="form-label fw-bold small text-muted">FECHA LÍMITE</label>
                        <input asp-for="DueDate" type="datetime-local" class="form-control fw-bold" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Guardar Fecha</button>
                </div>
            </form>
        </div>
    </div>
</div>