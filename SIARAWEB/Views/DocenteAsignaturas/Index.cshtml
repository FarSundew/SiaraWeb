@model IEnumerable<SIARAWEB.Models.DocenteAsignatura>

@{
    ViewData["Title"] = "Mapeo de Cursos";
    Layout = "_Layout";

}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #112d60; font-weight: 900;">CURSOS Y DOCENTES</h2>
        <a asp-action="Create" class="btn btn-warning fw-bold" style="background-color: #f4a915; color: #112d60;">
            ➕ AGREGAR ASIGNATURA A DOCENTE
        </a>
    </div>

    <div class="table-responsive shadow-sm" style="border-radius: 10px; overflow: hidden;">
        <table class="table table-striped table-hover text-center mb-0">
            <thead style="background-color: #112d60; color: white;">
                <tr>
                    <th>DOCENTE</th>
                    <th>ASIGNATURA</th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold">@Html.DisplayFor(modelItem => item.Docente.UserName)</td>
                        <td class="align-middle">@Html.DisplayFor(modelItem => item.Subject.Name)</td>
                        <td class="align-middle">
                            <!-- Aquí tu compañero puede agregar iconos institucionales -->
                            <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>