@model IEnumerable<SIARAWEB.Models.SemaforoViewModel>

@{
    ViewData["Title"] = "Semáforo de Cumplimiento";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin: 0;">
                <i class="bi bi-bar-chart-line-fill me-2"></i> PANEL DE AUDITORÍA Y REPORTES
            </h3>
            <p class="text-muted fw-bold mt-1 mb-0">Monitoreo automático de entregas y rendimiento académico.</p>
        </div>
        <!-- Botones para exportar (preparados para el RF12) -->
        <div class="d-flex gap-2">
            <button class="btn btn-danger fw-bold shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-file-earmark-pdf-fill"></i> Exportar PDF
            </button>
            <button class="btn btn-success fw-bold shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-file-earmark-excel-fill"></i> Exportar Excel
            </button>
        </div>
    </div>

    <!-- Contenedor de Gráficas Estadísticas -->
    <div class="row mb-5">
        <!-- Gráfica de Pastel (Índices Académicos) -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header text-white fw-bold text-center p-3" style="background-color: #112d60;">
                    <i class="bi bi-pie-chart-fill me-2"></i> RENDIMIENTO ACADÉMICO GLOBAL
                </div>
                <div class="card-body d-flex justify-content-center align-items-center bg-light">
                    <canvas id="pastelChart" style="max-height: 260px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Gráfica de Barras (Cumplimiento Docente) -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header text-white fw-bold text-center p-3" style="background-color: #112d60;">
                    <i class="bi bi-bar-chart-fill me-2"></i> ESTADO DE ENTREGAS DOCENTES
                </div>
                <div class="card-body bg-light">
                    <canvas id="barrasChart" style="max-height: 260px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla del Semáforo -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header text-white fw-bold p-3" style="background-color: #112d60; text-transform: uppercase;">
            <i class="bi bi-traffic-light me-2"></i> SEMÁFORO DE CUMPLIMIENTO DOCENTE
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead style="background-color: #f2f3f5; color: #112d60; font-weight: 900; font-size: 13px;">
                    <tr>
                        <th class="text-start p-3">ASIGNATURA</th>
                        <th class="text-start">DOCENTE</th>
                        <th>DOC. INICIALES</th>
                        <th>1ER SEGUIMIENTO</th>
                        <th>2DO SEGUIMIENTO</th>
                        <th>REPORTE FINAL</th>
                        <th>AUDITAR</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-start fw-bold p-3">@item.SubjectCode - @item.SubjectName</td>
                            <td class="text-start text-muted fw-bold">@item.DocenteName</td>

                            <!-- Indicadores del Semáforo con display: inline-block para que se vean -->
                            <td><span class="badge rounded-circle @item.ColorInicial shadow-sm" style="width: 22px; height: 22px; display: inline-block;"></span></td>
                            <td><span class="badge rounded-circle @item.ColorSeg1 shadow-sm" style="width: 22px; height: 22px; display: inline-block;"></span></td>
                            <td><span class="badge rounded-circle @item.ColorSeg2 shadow-sm" style="width: 22px; height: 22px; display: inline-block;"></span></td>
                            <td><span class="badge rounded-circle @item.ColorFinal shadow-sm" style="width: 22px; height: 22px; display: inline-block;" title="Reporte Final"></span></td>

                            <td>
                                <!-- Botón Detalles (Lupa) -->
                                <a asp-action="Details" asp-route-id="@item.SubjectId" class="btn btn-sm btn-outline-primary fw-bold" style="border-radius: 6px;">
                                    <i class="bi bi-search"></i> Detalles
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center p-4 text-muted fw-bold">
                                <i class="bi bi-info-circle-fill me-2 fs-5"></i><br />No hay asignaturas registradas para auditar en este periodo.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Leyenda de colores -->
    <div class="mt-3 d-flex gap-4 fw-bold text-muted justify-content-end p-2" style="font-size: 13px;">
        <div class="d-flex align-items-center"><span class="badge rounded-circle bg-success me-2 shadow-sm" style="width: 15px; height: 15px; display: inline-block;"></span> Entregado a Tiempo</div>
        <div class="d-flex align-items-center"><span class="badge rounded-circle bg-danger me-2 shadow-sm" style="width: 15px; height: 15px; display: inline-block;"></span> Entrega Desfasada</div>
        <div class="d-flex align-items-center"><span class="badge rounded-circle bg-secondary me-2 shadow-sm" style="width: 15px; height: 15px; display: inline-block;"></span> Pendiente / Sin entrega</div>
    </div>
</div>

@section Scripts {
    <!-- Importar Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // 1. Dibujar Gráfica de Pastel (Aprobación / Reprobación)
        const ctxPastel = document.getElementById('pastelChart').getContext('2d');
        new Chart(ctxPastel, {
            type: 'pie',
            data: {
                labels: ['Aprobación', 'Reprobación', 'Deserción'],
                datasets: [{
                    data: [@(ViewBag.Aprobacion ?? 0), @(ViewBag.Reprobacion ?? 0), @(ViewBag.Desercion ?? 0)],
                    backgroundColor: ['#198754', '#dc3545', '#6c757d'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // 2. Dibujar Gráfica de Barras (Entregas Docentes)
        const ctxBarras = document.getElementById('barrasChart').getContext('2d');
        new Chart(ctxBarras, {
            type: 'bar',
            data: {
                labels: ['A Tiempo', 'Desfasado', 'Pendiente'],
                datasets: [{
                    label: 'Cantidad de Materias',
                    data: [@(ViewBag.DocsATiempo ?? 0), @(ViewBag.DocsDesfasados ?? 0), @(ViewBag.DocsPendientes ?? 0)],
                    backgroundColor: ['#198754', '#dc3545', '#adb5bd'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}