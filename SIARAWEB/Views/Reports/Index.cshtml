@model IEnumerable<SIARAWEB.Models.ApplicationUser>

@{
    ViewData["Title"] = "Reportes por Docente";
    Layout = "_Layout";
}

<style>
    .container {
        max-width: 100% !important;
        padding: 0 !important;
    }

    main {
        padding-bottom: 0 !important;
    }
</style>
<link rel="stylesheet" href="~/css/estilos.css" />

<div style="background-color: #f4f6f9; padding-top: 25px; padding-bottom: 40px; min-height: 100vh; width: 100%;">

    <div style="margin: 0 40px; background-color: #f2f3f5; border: 2px solid #ccc; border-radius: 15px; position: relative; padding-bottom: 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">

        <a asp-controller="Home" asp-action="Index" class="btn-cerrar-rojo">&#10005;</a>

        <div style="background-color: #112d60; color: white; text-align: center; font-weight: 900; padding: 15px; border-radius: 13px 13px 0 0; font-size: 20px; margin-bottom: 25px; text-transform: uppercase;">
            SEGUIMIENTO ACADÉMICO POR DOCENTE
        </div>

        <div style="padding: 0 30px;">
            <p class="text-muted fw-bold mb-4">Seleccione un docente de la lista para visualizar sus asignaturas y generar su reporte de avance.</p>

            <table class="tabla-dashboard" style="width: 100%; text-align: center;">
                <thead>
                    <tr>
                        <th style="width: 35%; text-align: left;">NOMBRE DEL DOCENTE &#128269;</th>
                        <th style="width: 25%;">CORREO INSTITUCIONAL</th>
                        <th style="width: 20%;">RFC</th>
                        <th style="width: 20%;">REPORTES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size: 14px; text-transform: uppercase; font-weight: 900; text-align: left;"></td>
                                <td style="font-size: 14px; font-weight: 900;">@item.Email</td>
                                <td style="font-size: 14px; font-weight: 900;"></td>
                                <td>
                                    <!-- ⚠️ Este botón envía el ID del maestro al método DocenteReport -->
                                    <div style="display: flex; justify-content: center;">
                                        <a asp-action="DocenteReport" asp-route-id="@item.Id" class="btn-siara-3d" style="text-decoration: none; padding: 8px 15px; font-size: 12px; margin: 0;">
                                            📄 VER REPORTE
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="padding: 30px; color: #666; font-size: 16px; font-weight: bold;">
                                No se encontraron docentes en el sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="display: flex; justify-content: flex-start; padding: 25px 30px 0 30px;">
            <a asp-controller="Home" asp-action="Index" class="btn-siara-3d" style="text-decoration: none; background: linear-gradient(to bottom, #999, #666) !important; border-color: #555 !important;">VOLVER</a>
        </div>
    </div>
</div>