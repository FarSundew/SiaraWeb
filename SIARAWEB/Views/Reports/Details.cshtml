@model SIARAWEB.Models.Subject

@{
    ViewData["Title"] = "Detalles de Asignatura: " + Model.Name;
    var docente = Model.DocenteAsignaturas?.FirstOrDefault()?.Docente;
    string activeTab = (ViewBag.ActiveTab as string ?? "semaforo").ToLower();
    bool isSabanaActive = activeTab == "sabana" || activeTab == "tracks" || activeTab == "calificaciones";

    int? periodoId = ViewBag.PeriodoId as int?;
    int? departamentoId = ViewBag.DepartamentoId as int?;
    string? search = ViewBag.Search as string;

    var docsList = Model.Documents?.OrderByDescending(d => d.UploadedAt).ToList() ?? new List<SIARAWEB.Models.Document>();
    var tracksList = Model.AcademicTrackings?.OrderBy(t => t.DocumentTaskId).ThenBy(t => t.UnitNumber).ToList() ?? new List<SIARAWEB.Models.AcademicTracking>();

    var firstPdfDoc = docsList.FirstOrDefault(d => !string.IsNullOrEmpty(d.FilePath) && d.FilePath != "N/A");
    string firstPdfUrl = firstPdfDoc != null ? Url.Content("~/" + firstPdfDoc.FilePath.TrimStart('/')) : "";
    string firstPdfTitle = firstPdfDoc != null ? $"{firstPdfDoc.DocumentType} ({firstPdfDoc.DocumentTask?.Title})" : "Selecciona un documento para previsualizar";

    decimal avgApproval = tracksList.Any() ? Math.Round(tracksList.Average(t => t.ApprovalPercentage), 1) : 0m;
    decimal avgFailure = tracksList.Any() ? Math.Round(tracksList.Average(t => t.FailurePercentage), 1) : 0m;
    int docsOnTime = docsList.Count(d => d.IsOnTime);
    int docsApproved = docsList.Count(d => d.ApprovalStatus == "Aprobado");
}

<style>
    .doc-interactive-card {
        transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 2px solid transparent !important;
        cursor: pointer;
    }
    .doc-interactive-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(17, 45, 96, 0.12) !important;
        border-color: rgba(17, 45, 96, 0.25) !important;
    }
    .doc-interactive-card.active-doc {
        border-color: #112d60 !important;
        background-color: #f4f7fb !important;
        box-shadow: 0 6px 18px rgba(17, 45, 96, 0.15) !important;
    }
    .phase-filter-btn {
        transition: all 0.2s ease;
    }
    .pdf-viewer-container {
        position: sticky;
        top: 90px;
        border-radius: 16px;
        overflow: hidden;
        background: #1e293b;
    }
</style>

<div class="container-fluid mt-3">
    <!-- Encabezado Dinámico Institucional -->
    <div class="card border-0 shadow-sm mb-4 p-4 text-white" style="background: linear-gradient(135deg, #112d60 0%, #1d428a 100%); border-radius: 16px;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">@Model.Code</span>
                    @if (Model.Semestre > 0)
                    {
                        <span class="badge bg-light text-dark fw-bold px-3 py-1 rounded-pill">@(Model.Semestre)° Semestre</span>
                    }
                    <span class="badge bg-white bg-opacity-25 text-white fw-bold px-3 py-1 rounded-pill">
                        <i class="bi bi-building me-1"></i> @(Model.Departamento?.Name ?? "Departamento General")
                    </span>
                </div>
                <h3 class="fw-bold mb-1">@Model.Name</h3>
                <p class="mb-0 opacity-75 fw-semibold">
                    <i class="bi bi-person-badge-fill me-1 text-warning"></i> Docente Titular: <strong>@(docente?.FullName ?? "Sin Asignar")</strong>
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                @if (docente != null)
                {
                    <a href="@Url.Action("ExportPdf", "Reports", new { periodoId = periodoId, departamentoId = departamentoId, docenteId = docente.Id })"
                       class="btn btn-warning text-dark fw-bold shadow-sm px-4 py-2 rounded-pill">
                        <i class="bi bi-file-earmark-pdf-fill me-1 text-danger"></i> Reporte PDF del Docente
                    </a>
                }
                <a id="backToDashboardBtn"
                   href="@Url.Action("Index", "Reports", new { tab = (isSabanaActive ? "sabana" : "semaforo"), periodoId = periodoId, departamentoId = departamentoId, search = search })"
                   class="btn btn-light fw-bold shadow-sm px-4 py-2 rounded-pill"
                   style="color: #112d60;">
                    <i class="bi bi-arrow-left-circle-fill me-1"></i> Volver a <span id="backTabLabel">@(isSabanaActive ? "Sábana de Rendimiento" : "Semáforo de Docentes")</span>
                </a>
            </div>
        </div>

        <!-- Mini KPIs de la Asignatura -->
        <div class="row g-3 mt-3 pt-3 border-top border-white border-opacity-25">
            <div class="col-6 col-md-3">
                <div class="bg-white bg-opacity-10 rounded-3 p-2 px-3">
                    <small class="d-block opacity-75 fw-bold" style="font-size: 11px;">EVIDENCIAS ENTREGADAS</small>
                    <span class="fs-5 fw-bold">@docsList.Count archivo(s)</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="bg-white bg-opacity-10 rounded-3 p-2 px-3">
                    <small class="d-block opacity-75 fw-bold" style="font-size: 11px;">PUNTUALIDAD / APROBADOS</small>
                    <span class="fs-5 fw-bold text-warning">@docsOnTime a tiempo · @docsApproved validados</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="bg-white bg-opacity-10 rounded-3 p-2 px-3">
                    <small class="d-block opacity-75 fw-bold" style="font-size: 11px;">PROMEDIO APROBACIÓN</small>
                    <span class="fs-5 fw-bold text-info">@avgApproval.ToString("0.0")%</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="bg-white bg-opacity-10 rounded-3 p-2 px-3">
                    <small class="d-block opacity-75 fw-bold" style="font-size: 11px;">PROMEDIO REPROBACIÓN</small>
                    <span class="fs-5 fw-bold @(avgFailure >= 40 ? "text-danger" : "text-white")">@avgFailure.ToString("0.0")%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestañas de Navegación Sincronizadas con el Tablero -->
    <ul class="nav nav-pills mb-4 fw-bold gap-2" id="detailsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(!isSabanaActive ? "active" : "") rounded-pill px-4 py-2 shadow-sm"
                    id="docs-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#docs"
                    data-return-tab="semaforo"
                    data-return-label="Semáforo de Docentes"
                    type="button"
                    role="tab">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Visor de Documentos (Semáforo)
                <span class="badge bg-white text-dark ms-1 rounded-pill">@docsList.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(isSabanaActive ? "active" : "") rounded-pill px-4 py-2 shadow-sm"
                    id="tracks-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#tracks"
                    data-return-tab="sabana"
                    data-return-label="Sábana de Rendimiento"
                    type="button"
                    role="tab">
                <i class="bi bi-clipboard-data-fill me-1"></i> Calificaciones y Sábana por Unidad
                <span class="badge bg-white text-dark ms-1 rounded-pill">@tracksList.Count</span>
            </button>
        </li>
    </ul>

    <!-- Contenido de las Pestañas -->
    <div class="tab-content" id="detailsTabsContent">

        <!-- TAB 1: VISOR INTERACTIVO DE DOCUMENTACIÓN -->
        <div class="tab-pane fade @(!isSabanaActive ? "show active" : "")" id="docs" role="tabpanel">
            @if (!docsList.Any())
            {
                <div class="card shadow-sm border-0 rounded-4 p-5 text-center text-muted">
                    <i class="bi bi-folder-x display-3 d-block mb-3 text-secondary opacity-50"></i>
                    <h5 class="fw-bold text-dark">Sin Documentos Registrados</h5>
                    <p class="mb-0">El docente aún no ha subido evidencias documentales para esta asignatura.</p>
                </div>
            }
            else
            {
                <!-- Barra de Filtro Rápido por Fase -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 bg-white p-3 rounded-4 shadow-sm">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted fw-bold small me-1"><i class="bi bi-funnel-fill me-1"></i> FILTRAR POR FASE:</span>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill fw-bold phase-filter-btn" onclick="filterDocsByPhase('ALL', this)">
                            Todas (@docsList.Count)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold phase-filter-btn" onclick="filterDocsByPhase('Inicial', this)">
                            Inicial (@docsList.Count(d => d.DocumentTask?.PhaseType == "Inicial"))
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold phase-filter-btn" onclick="filterDocsByPhase('Seguimiento1', this)">
                            1er Seguimiento (@docsList.Count(d => d.DocumentTask?.PhaseType == "Seguimiento1"))
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold phase-filter-btn" onclick="filterDocsByPhase('Seguimiento2', this)">
                            2do Seguimiento (@docsList.Count(d => d.DocumentTask?.PhaseType == "Seguimiento2"))
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold phase-filter-btn" onclick="filterDocsByPhase('Final', this)">
                            Reporte Final (@docsList.Count(d => d.DocumentTask?.PhaseType == "Final"))
                        </button>
                    </div>
                    <small class="text-muted fw-semibold">
                        <i class="bi bi-hand-index-thumb me-1 text-primary"></i> Haz clic en cualquier tarjeta para visualizar el PDF al instante
                    </small>
                </div>

                <div class="row g-4">
                    <!-- Columna Izquierda: Tarjetas Interactivas de Documentos -->
                    <div class="col-lg-5">
                        <div class="d-flex flex-column gap-3" id="docCardsContainer">
                            @foreach (var doc in docsList)
                            {
                                bool isPdfAvailable = !string.IsNullOrEmpty(doc.FilePath) && doc.FilePath != "N/A";
                                string pdfUrl = isPdfAvailable ? Url.Content("~/" + doc.FilePath.TrimStart('/')) : "";
                                string phaseType = doc.DocumentTask?.PhaseType ?? "General";
                                string docTitle = string.IsNullOrWhiteSpace(doc.DocumentType) ? (doc.DocumentTask?.Title ?? "Evidencia PDF") : doc.DocumentType;
                                bool isFirst = firstPdfDoc != null && firstPdfDoc.Id == doc.Id;

                                string phaseBadgeClass = phaseType switch
                                {
                                    "Inicial" => "bg-primary",
                                    "Seguimiento1" => "bg-info text-dark",
                                    "Seguimiento2" => "bg-warning text-dark",
                                    "Final" => "bg-success",
                                    _ => "bg-secondary"
                                };

                                <div class="card shadow-sm rounded-4 p-3 doc-interactive-card @(isFirst ? "active-doc" : "")"
                                     data-phase="@phaseType"
                                     onclick="@(isPdfAvailable ? $"previewDocument('{pdfUrl}', '{docTitle.Replace("'", "\\'")}', '{doc.DocumentTask?.Title?.Replace("'", "\\'")}', this)" : "")">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center shadow-sm"
                                             style="background-color: @(isPdfAvailable ? "#fee2e2" : "#f1f5f9"); min-width: 54px; height: 54px;">
                                            <i class="bi @(isPdfAvailable ? "bi-file-earmark-pdf-fill text-danger" : "bi-slash-circle text-secondary") fs-3"></i>
                                        </div>

                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-1 mb-1">
                                                <span class="badge @phaseBadgeClass rounded-pill" style="font-size: 11px;">
                                                    @(doc.DocumentTask?.Title ?? phaseType)
                                                </span>
                                                <div class="d-flex gap-1">
                                                    @if (doc.FilePath == "N/A")
                                                    {
                                                        <span class="badge bg-secondary" style="font-size: 10px;">NO APLICA</span>
                                                    }
                                                    else if (doc.IsOnTime)
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success" style="font-size: 10px;">
                                                            <i class="bi bi-check-circle-fill me-1"></i>A Tiempo
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size: 10px;">
                                                            <i class="bi bi-clock-history me-1"></i>Desfasado
                                                        </span>
                                                    }

                                                    @if (doc.ApprovalStatus == "Aprobado")
                                                    {
                                                        <span class="badge bg-success" style="font-size: 10px;">Aprobado</span>
                                                    }
                                                    else if (doc.ApprovalStatus == "Rechazado")
                                                    {
                                                        <span class="badge bg-danger" style="font-size: 10px;">Rechazado</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark" style="font-size: 10px;">En Revisión</span>
                                                    }
                                                </div>
                                            </div>

                                            <h6 class="fw-bold text-dark mb-1">@docTitle</h6>

                                            <div class="text-muted small d-flex flex-wrap gap-3" style="font-size: 12px;">
                                                <span><i class="bi bi-calendar-check me-1"></i>@doc.UploadedAt.ToString("dd/MMM/yyyy HH:mm") hrs</span>
                                                @if (doc.CorrectionSubmissionDate.HasValue)
                                                {
                                                    <span class="text-primary fw-semibold">
                                                        <i class="bi bi-arrow-repeat me-1"></i>Corregido: @doc.CorrectionSubmissionDate.Value.ToString("dd/MMM/yyyy HH:mm")
                                                    </span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(doc.Feedback))
                                            {
                                                <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small fw-semibold" style="font-size: 11px;">
                                                    <i class="bi bi-chat-left-quote-fill me-1"></i> Observación: @doc.Feedback
                                                </div>
                                            }

                                            <div class="d-flex justify-content-end gap-2 mt-2 pt-2 border-top">
                                                @if (isPdfAvailable)
                                                {
                                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold"
                                                            onclick="event.stopPropagation(); previewDocument('@pdfUrl', '@docTitle.Replace("'", "\\'")', '@(doc.DocumentTask?.Title?.Replace("'", "\\'"))', this.closest('.doc-interactive-card'))">
                                                        <i class="bi bi-eye-fill me-1"></i> Vista Previa
                                                    </button>
                                                    <a href="@pdfUrl" target="_blank" onclick="event.stopPropagation();" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" title="Abrir PDF en pestaña nueva">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i> Abrir
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small fst-italic">Marcado como No Aplica (N/A)</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Columna Derecha: Visor Interactivo de PDF Integrado -->
                    <div class="col-lg-7">
                        <div class="pdf-viewer-container shadow-lg">
                            <div class="d-flex justify-content-between align-items-center px-4 py-3 text-white" style="background-color: #112d60;">
                                <div class="text-truncate me-2">
                                    <span class="badge bg-warning text-dark me-2">VISOR EN VIVO</span>
                                    <strong id="pdfViewerTitle" class="text-white">@firstPdfTitle</strong>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (!string.IsNullOrEmpty(firstPdfUrl))
                                    {
                                        <a id="pdfExternalLink" href="@firstPdfUrl" target="_blank" class="btn btn-sm btn-light fw-bold rounded-pill px-3" style="color: #112d60;">
                                            <i class="bi bi-arrows-fullscreen me-1"></i> Pantalla Completa
                                        </a>
                                    }
                                </div>
                            </div>
                            <div class="bg-dark d-flex align-items-center justify-content-center" style="height: 620px;">
                                @if (!string.IsNullOrEmpty(firstPdfUrl))
                                {
                                    <iframe id="pdfPreviewFrame" src="@firstPdfUrl" style="width: 100%; height: 100%; border: none; background-color: #fff;"></iframe>
                                }
                                else
                                {
                                    <div class="text-center text-light p-5 opacity-75">
                                        <i class="bi bi-file-earmark-pdf display-1 d-block mb-3"></i>
                                        <h5>No hay archivo PDF seleccionable para previsualizar</h5>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- TAB 2: HISTORIAL SÁBANA / CALIFICACIONES POR UNIDAD -->
        <div class="tab-pane fade @(isSabanaActive ? "show active" : "")" id="tracks" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header text-white fw-bold p-3 d-flex justify-content-between align-items-center" style="background-color: #112d60;">
                    <div>
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> DESGLOSE DE CALIFICACIONES Y RENDIMIENTO POR UNIDAD (SÁBANA)
                    </div>
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1">
                        @tracksList.Count unidad(es) evaluada(s)
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0" style="font-size: 14px;">
                        <thead class="bg-light text-muted fw-bold">
                            <tr>
                                <th class="text-start ps-4" style="width: 22%;">FASE / TAREA</th>
                                <th style="width: 12%;">UNIDAD</th>
                                <th style="width: 18%;">% APROBACIÓN</th>
                                <th style="width: 18%;">% REPROBACIÓN</th>
                                <th style="width: 10%;">% DESERCIÓN</th>
                                <th class="text-start" style="width: 20%;">ACCIÓN CORRECTIVA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!tracksList.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-muted fw-bold py-5 text-center">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                                        No hay calificaciones ni métricas de rendimiento registradas para esta asignatura.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var track in tracksList)
                                {
                                    bool isHighRisk = track.FailurePercentage >= 40.0m;
                                    <tr class="@(isHighRisk ? "table-danger bg-opacity-10" : "")">
                                        <td class="text-start fw-bold ps-4" style="color: #112d60;">
                                            @(track.DocumentTask?.Title ?? "Seguimiento")
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill px-3 py-2 fw-bold" style="background-color: #112d60;">
                                                Tema @track.UnitNumber
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column align-items-center px-2">
                                                <span class="text-success fw-bold mb-1">@track.ApprovalPercentage.ToString("0.0")%</span>
                                                <div class="progress w-100" style="height: 7px; border-radius: 10px;">
                                                    <div class="progress-bar bg-success" role="progressbar" style="width: @(Math.Min(100, (int)track.ApprovalPercentage))%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column align-items-center px-2">
                                                <span class="text-danger fw-bold mb-1">
                                                    @track.FailurePercentage.ToString("0.0")%
                                                    @if (isHighRisk)
                                                    {
                                                        <span class="badge bg-danger ms-1" style="font-size: 10px;">ALERTA ≥40%</span>
                                                    }
                                                </span>
                                                <div class="progress w-100" style="height: 7px; border-radius: 10px;">
                                                    <div class="progress-bar bg-danger" role="progressbar" style="width: @(Math.Min(100, (int)track.FailurePercentage))%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-warning fw-bold">
                                            @track.DropoutPercentage.ToString("0.0")%
                                        </td>
                                        <td class="text-start small pe-4">
                                            @if (!string.IsNullOrWhiteSpace(track.Observations))
                                            {
                                                <div class="p-2 rounded-3 bg-white border border-warning shadow-sm text-dark fw-semibold">
                                                    <i class="bi bi-tools text-warning me-1"></i> @track.Observations
                                                </div>
                                            }
                                            else if (isHighRisk)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Sin acción correctiva registrada
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted"><i class="bi bi-check2-circle text-success me-1"></i> Sin riesgo crítico</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Actualizar el botón "Volver a..." según la pestaña activa (Semáforo vs Sábana)
        const baseReturnUrl = '@Html.Raw(Url.Action("Index", "Reports", new { periodoId = periodoId, departamentoId = departamentoId, search = search }))';

        document.querySelectorAll('#detailsTabs button[data-bs-toggle="pill"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (event) {
                const returnTab = event.target.getAttribute('data-return-tab') || 'semaforo';
                const returnLabel = event.target.getAttribute('data-return-label') || 'Tablero';
                const backBtn = document.getElementById('backToDashboardBtn');
                const backLabel = document.getElementById('backTabLabel');

                if (backBtn) {
                    const separator = baseReturnUrl.includes('?') ? '&' : '?';
                    backBtn.href = `${baseReturnUrl}${separator}tab=${returnTab}`;
                }
                if (backLabel) {
                    backLabel.textContent = returnLabel;
                }
            });
        });

        // Cambiar documento en el visor interactivo
        function previewDocument(url, docTitle, taskTitle, cardElement) {
            const frame = document.getElementById('pdfPreviewFrame');
            const titleEl = document.getElementById('pdfViewerTitle');
            const extLink = document.getElementById('pdfExternalLink');

            if (frame && url) {
                frame.src = url;
            }
            if (titleEl) {
                titleEl.textContent = taskTitle ? `${docTitle} (${taskTitle})` : docTitle;
            }
            if (extLink && url) {
                extLink.href = url;
            }

            document.querySelectorAll('.doc-interactive-card').forEach(c => c.classList.remove('active-doc'));
            if (cardElement) {
                cardElement.classList.add('active-doc');
            }
        }

        // Filtrar tarjetas de documentos por Fase Académica
        function filterDocsByPhase(phase, btnElement) {
            document.querySelectorAll('.phase-filter-btn').forEach(b => {
                b.classList.remove('btn-primary');
                b.classList.add('btn-outline-secondary');
            });
            if (btnElement) {
                btnElement.classList.remove('btn-outline-secondary');
                btnElement.classList.add('btn-primary');
            }

            document.querySelectorAll('#docCardsContainer .doc-interactive-card').forEach(card => {
                const cardPhase = card.getAttribute('data-phase');
                if (phase === 'ALL' || cardPhase === phase) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
}
