@model IEnumerable<SIARAWEB.Models.Subject>

@{
    ViewData["Title"] = "Mis Documentos";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: #112d60;">📄 Repositorio de Documentos</h2>
            <p class="text-muted m-0">Sube tu instrumentación didáctica y evidencias por cada asignatura asignada.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-folder-x display-4 d-block mb-3"></i>
                <p class="fs-5">No tienes asignaturas asignadas en este periodo escolar.</p>
                <small>Si crees que esto es un error, contacta a tu Jefe de Carrera.</small>
            </div>
        }

        @foreach (var subject in Model)
        {
            // Lógica rápida para saber si ya entregó documentos
            int totalDocumentos = subject?.Documents?.Count ?? 0;

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow-sm h-100 border-0" style="border-radius: 12px; border-top: 5px solid #112d60 !important;">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold m-0" style="color: #112d60;">@subject?.Name</h5>
                            </div>
                            <p class="text-muted mb-3"><i class="bi bi-upc-scan me-1"></i> Clave: <strong>@subject?.Code</strong></p>

                            <div class="p-3 mb-3 bg-light rounded-3">
                                <div class="d-flex align-items-center text-muted mb-2" style="font-size: 14px;">
                                    <i class="bi bi-calendar3 text-primary me-2 fs-5"></i>
                                    <span>Periodo: <strong>@subject?.AcademicPeriod?.Name</strong></span>
                                </div>
                                <div class="d-flex align-items-center text-muted" style="font-size: 14px;">
                                    <i class="bi bi-file-earmark-pdf text-danger me-2 fs-5"></i>
                                    <span>Archivos subidos: <strong>@totalDocumentos</strong></span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <a asp-action="Upload" asp-route-id="@subject.Id" class="btn w-100 py-2 fw-bold text-white" style="background-color: #f4a915; border-radius: 8px; color: #112d60 !important;">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> Subir Documentos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>