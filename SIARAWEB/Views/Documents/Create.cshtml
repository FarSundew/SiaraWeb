@model SIARAWEB.Models.Document

@{
    ViewData["Title"] = "Subir Documento";
    Layout = "_Layout";
    var faseActual = ViewBag.FechaCorte != null ? ViewBag.FechaCorte.Phase : "Documentos Iniciales";
}

<div class="container mt-5">
    <div class="card shadow-sm" style="border-radius: 10px; border-top: 5px solid #112d60;">
        <div class="card-body p-5">

            <h2 class="mb-4" style="color: #112d60; font-weight: 900;">
                SUBIR ARCHIVO: @faseActual.ToUpper()
            </h2>

            <!-- Recuadro elegante con la información pre-cargada -->
            <div class="alert alert-info shadow-sm" style="background-color: #e9f2ff; border-left: 6px solid #112d60; border-radius: 8px;">
                <h5 class="mb-2" style="color: #112d60;">
                    <strong>Asignatura:</strong> @ViewBag.MateriaNombre
                </h5>
                <h5 class="mb-0" style="color: #112d60;">
                    <strong>Documento Requerido:</strong> @Model.Type
                </h5>
            </div>

            <p class="text-muted mt-4 mb-4">
                Por favor, adjunta el archivo correspondiente en formato PDF.
            </p>

            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- ⚠️ LOS DATOS MAGICOS OCULTOS QUE VIAJAN AL SERVIDOR -->
                <input type="hidden" asp-for="SubjectId" />
                <input type="hidden" asp-for="Type" />

                <div class="row mt-4">
                    <div class="col-md-12 mb-4">
                        <input type="file" name="archivoPdf" id="archivoPdf" class="form-control form-control-lg border-2" accept=".pdf" required />
                    </div>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-end gap-3 mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 py-2">⬅ REGRESAR</a>

                    <button type="submit" class="btn fw-bold px-4 py-2" style="background-color: #f4a915; color: #112d60;">
                        ☁️ SUBIR ARCHIVO
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}