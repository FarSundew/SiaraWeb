@model SIARAWEB.Models.Document

@{
    ViewData["Title"] = "Detalles del Documento";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="card shadow-sm" style="border-radius: 10px; border-top: 5px solid #112d60;">
        <div class="card-body p-4">
            <h2 style="color: #112d60; font-weight: 900;">DETALLES DEL DOCUMENTO</h2>
            <hr />
            <dl class="row mt-4">
                <dt class="col-sm-3" style="color: #112d60;">Asignatura</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Subject.Name)</dd>

                <dt class="col-sm-3" style="color: #112d60;">Tipo de Documento</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Type)</dd>

                <dt class="col-sm-3" style="color: #112d60;">Fecha de Subida</dt>
                <dd class="col-sm-9">@Model.UploadedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3" style="color: #112d60;">Estado</dt>
                <dd class="col-sm-9">
                    @(Model.IsOnTime ? "✅ Entregado a Tiempo" : "❌ Entregado Fuera de Tiempo")
                </dd>

                <dt class="col-sm-3" style="color: #112d60;">Archivo PDF</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.FilePath))
                    {
                        <a href="@Model.FilePath" target="_blank" class="btn btn-sm btn-primary" style="background-color: #f4a915; color: #112d60; border: none; font-weight: bold;">
                            📄 VER DOCUMENTO
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No hay archivo adjunto.</span>
                    }
                </dd>
            </dl>
            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
            </div>
        </div>
    </div>
</div>