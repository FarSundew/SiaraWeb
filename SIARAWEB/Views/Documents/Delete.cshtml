@model SIARAWEB.Models.Document

@{
    ViewData["Title"] = "Eliminar Documento";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="alert alert-danger shadow-sm">
        <h3 class="fw-bold mb-0">¿Estás seguro de que deseas eliminar este documento?</h3>
        <p class="mb-0 mt-2">Esta acción no se puede deshacer y el archivo PDF se perderá.</p>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-3">Asignatura</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Subject.Name)</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Type)</dd>

                <dt class="col-sm-3">Fecha de Subida</dt>
                <dd class="col-sm-9">@Model.UploadedAt.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger fw-bold">🗑️ ELIMINAR DOCUMENTO</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>