@model SIARAWEB.Models.Subject

@{
    ViewData["Title"] = "Entrega de Documentos";
    var task = ViewBag.Task as SIARAWEB.Models.DocumentTask;
    var docsRequeridos = ViewBag.DocumentosRequeridos as List<string> ?? new List<string>();
    bool estaCerrada = task != null && DateTime.Now > task.DueDate;
}

<div class="container-fluid mt-4">
    <!-- Encabezado de la Tarea / Asignatura -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin-bottom: 0;">
                <i class="bi bi-cloud-arrow-up-fill me-2"></i> BUZÓN: @(task?.Title ?? "Entrega de Evidencias")
            </h3>
            <p class="text-muted fw-bold mb-0">
                Materia: <strong class="text-dark">@Model.Name (@Model.Code)</strong> |
                Fase: <span class="badge bg-primary">@(task?.PhaseType ?? "General")</span> |
                Fecha Límite: <span class="@(estaCerrada ? "text-danger" : "text-success") fw-bold">@task?.DueDate.ToString("dd/MMM/yyyy HH:mm") hrs</span>
            </p>
        </div>
        <a asp-controller="DocumentTasks" asp-action="DocenteTasks" class="btn btn-outline-secondary fw-bold px-3 py-2" style="border-radius: 8px;">
            <i class="bi bi-arrow-left me-1"></i> Regresar a Mis Tareas
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold text-center shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (estaCerrada)
    {
        <div class="alert alert-warning fw-bold text-center shadow-sm">
            <i class="bi bi-clock-history me-2"></i> La fecha límite de este buzón ha vencido. Las entregas nuevas se registrarán con retraso.
        </div>
    }

    <!-- Tabla de Entregas -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header text-white fw-bold py-3 px-4" style="background-color: #112d60;">
            <i class="bi bi-file-earmark-check me-2" style="color: #f4a915;"></i> EVIDENCIAS REQUERIDAS DE LA FASE
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size: 14px;">
                    <thead style="background-color: #f2f3f5; color: #112d60; font-weight: 900;">
                        <tr>
                            <th style="width: 28%;" class="text-start ps-4">DOCUMENTO</th>
                            <th style="width: 32%;">SUBIR / CORREGIR</th>
                            <th style="width: 14%;">PUNTUALIDAD</th>
                            <th style="width: 14%;">DICTAMEN JEFATURA</th>
                            <th style="width: 12%;">VER ARCHIVO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var docName in docsRequeridos)
                        {
                            var docSubido = Model.Documents?.FirstOrDefault(d => d.DocumentType == docName && (task == null || d.DocumentTaskId == task.Id));

                            <tr>
                                <td class="text-start ps-4 fw-bold text-dark">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i> @docName
                                </td>

                                <!-- Formulario de Envío -->
                                <td>
                                    @if (docSubido == null || docSubido.ApprovalStatus == "Rechazado")
                                    {
                                        <form asp-action="UploadTaskDocument" method="post" enctype="multipart/form-data" class="d-flex justify-content-center align-items-center gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="subjectId" value="@Model.Id" />
                                            <input type="hidden" name="documentType" value="@docName" />
                                            <input type="hidden" name="documentTaskId" value="@(task?.Id ?? 0)" />

                                            <input type="file" name="file" class="form-control form-control-sm" accept=".pdf" style="max-width: 220px;" required />
                                            <button type="submit" class="btn btn-sm text-white fw-bold px-3" style="background-color: #112d60;">
                                                @(docSubido == null ? "Subir" : "Corregir")
                                            </button>

                                            @if (docName.ToLower().Contains("proy") || docName.ToLower().Contains("práct"))
                                            {
                                                <button type="submit" name="isNotApplicable" value="true" class="btn btn-sm btn-secondary fw-bold" formnovalidate title="Marcar si no aplica">
                                                    N/A
                                                </button>
                                            }
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i> Entregado
                                        </span>
                                    }
                                </td>

                                <!-- Semáforo de Puntualidad -->
                                <td>
                                    @if (docSubido != null)
                                    {
                                        if (docSubido.FilePath == "N/A")
                                        {
                                            <span class="badge bg-secondary">NO APLICA</span>
                                        }
                                        else if (docSubido.IsOnTime)
                                        {
                                            <span class="badge bg-success">A TIEMPO</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">RETRASO</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">PENDIENTE</span>
                                    }
                                </td>

                                <!-- Dictamen y Feedback de Jefatura -->
                                <td>
                                    @if (docSubido != null)
                                    {
                                        if (docSubido.ApprovalStatus == "Aprobado")
                                        {
                                            <span class="badge bg-success">APROBADO</span>
                                        }
                                        else if (docSubido.ApprovalStatus == "Rechazado")
                                        {
                                            <span class="badge bg-danger d-block mb-1">RECHAZADO</span>
                                            @if (!string.IsNullOrEmpty(docSubido.Feedback))
                                            {
                                                <small class="text-danger fw-bold d-block" style="font-size: 11px;">
                                                    Obs: @docSubido.Feedback
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">EN REVISIÓN</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <!-- Ver PDF -->
                                <td>
                                    @if (docSubido != null && docSubido.FilePath != "N/A")
                                    {
                                        string pdfUrl = Url.Content("~/" + docSubido.FilePath.TrimStart('/'));
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary fw-bold px-3 rounded-pill"
                                                onclick="openUploadPdfModal('@pdfUrl', '@docName.Replace("'", "\\'")')">
                                            <i class="bi bi-eye-fill me-1"></i> Ver PDF
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Visor Interactivo de PDF -->
<div class="modal fade" id="uploadPdfModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white py-3 px-4" style="background-color: #112d60;">
                <h6 class="modal-title fw-bold mb-0">
                    <i class="bi bi-file-earmark-pdf-fill text-warning me-2"></i>
                    <span id="uploadPdfModalTitle">Vista Previa del Documento</span>
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <a id="uploadPdfModalExt" href="#" target="_blank" class="btn btn-sm btn-light fw-bold rounded-pill px-3" style="color: #112d60;">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Abrir en Pestaña
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0 bg-dark" style="height: 75vh;">
                <iframe id="uploadPdfModalFrame" src="" style="width: 100%; height: 100%; border: none; background-color: #fff;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openUploadPdfModal(url, title) {
            const iframe = document.getElementById('uploadPdfModalFrame');
            const titleEl = document.getElementById('uploadPdfModalTitle');
            const extBtn = document.getElementById('uploadPdfModalExt');
            if (iframe) iframe.src = url;
            if (titleEl) titleEl.textContent = title || 'Vista Previa del Documento';
            if (extBtn) extBtn.href = url;
            const modal = new bootstrap.Modal(document.getElementById('uploadPdfModal'));
            modal.show();
        }
    </script>
}
