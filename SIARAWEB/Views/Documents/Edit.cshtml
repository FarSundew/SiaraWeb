@model SIARAWEB.Models.Document

@{
    ViewData["Title"] = "Editar Documento";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4">
        <h3 style="color: #112d60; font-weight: 900;">EDITAR REGISTRO</h3>
        <hr />
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Propiedades ocultas que el controlador necesita para no perder los datos -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FilePath" />
            <input type="hidden" asp-for="UploadedAt" />
            <input type="hidden" asp-for="IsOnTime" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SubjectId" class="control-label fw-bold">Asignatura</label>
                    <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectId"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Type" class="control-label fw-bold">Tipo de Documento</label>
                    <select asp-for="Type" class="form-control">
                        <option value="Instrumentación Didáctica">Instrumentación Didáctica</option>
                        <option value="Instrumento de Evaluación">Instrumento de Evaluación</option>
                        <option value="Práctica de Laboratorio">Práctica de Laboratorio</option>
                        <option value="Proyecto Individual">Proyecto Individual</option>
                    </select>
                </div>
            </div>

            <div class="mt-3">
                <input type="submit" value="Guardar Cambios" class="btn fw-bold" style="background-color: #112d60; color: white;" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Regresar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}