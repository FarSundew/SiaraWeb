@model SIARAWEB.Models.DocumentTask

@{
    ViewData["Title"] = "Modificar Tarea";
    string currentPeriodName = Model.AcademicPeriod?.Name ?? "";
    bool isJulio = currentPeriodName.Contains("Julio", StringComparison.OrdinalIgnoreCase);
    int currentYear = 2026;
    var matchYear = System.Text.RegularExpressions.Regex.Match(currentPeriodName, @"\d{4}");
    if (matchYear.Success) int.TryParse(matchYear.Value, out currentYear);
}

<div class="container py-4" style="max-width: 750px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header text-white py-3 px-4" style="background-color: #112d60; border-radius: 12px 12px 0 0;">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Modificar Tarea / Buz�n</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">T�TULO DE LA ENTREGA</label>
                    <input type="text" name="title" value="@Model.Title" class="form-control form-control-lg" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">SEMESTRE</label>
                        <select name="semestre" id="selectSemestre" class="form-select" required>
                            <option value="Enero - Junio" selected="@(!isJulio)">Enero - Junio</option>
                            <option value="Julio - Diciembre" selected="@(isJulio)">Julio - Diciembre</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">A�O</label>
                        <select name="anio" id="selectAnio" class="form-select" required>
                            @for (int y = 2024; y <= 2030; y++)
                            {
                                <option value="@y" selected="@(y == currentYear)">@y</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="alert alert-light border d-flex align-items-center mb-3 py-2">
                    <i class="bi bi-info-circle-fill text-primary me-2"></i>
                    <div>Periodo Asignado: <strong id="lblPeriodo" class="text-primary">@currentPeriodName</strong></div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">FASE ACAD�MICA</label>
                        <select name="phaseType" class="form-select" required>
                            <option value="Inicial" selected="@(Model.PhaseType == "Inicial")">Documentos Iniciales</option>
                            <option value="Seguimiento1" selected="@(Model.PhaseType == "Seguimiento1")">1er Seguimiento</option>
                            <option value="Seguimiento2" selected="@(Model.PhaseType == "Seguimiento2")">2do Seguimiento</option>
                            <option value="Final" selected="@(Model.PhaseType == "Final")">Reporte Final</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">FECHA Y HORA L�MITE (DUEDATE)</label>
                        <input type="datetime-local" name="dueDate" value="@Model.DueDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-muted small">INSTRUCCIONES / OBSERVACIONES</label>
                    <textarea name="description" class="form-control" rows="3">@Model.Description</textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Cancelar</a>
                    <button type="submit" class="btn text-white px-4 fw-bold" style="background-color: #112d60;">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const selSemestre = document.getElementById('selectSemestre');
    const selAnio = document.getElementById('selectAnio');
    const lblPeriodo = document.getElementById('lblPeriodo');

    function actualizarPeriodo() {
        lblPeriodo.textContent = `${selSemestre.value} ${selAnio.value}`;
    }
    selSemestre.addEventListener('change', actualizarPeriodo);
    selAnio.addEventListener('change', actualizarPeriodo);
</script>

