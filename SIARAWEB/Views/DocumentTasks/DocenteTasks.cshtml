@model IEnumerable<SIARAWEB.Models.DocumentTask>

@{
    ViewData["Title"] = "Mis Tareas y Buzones";
    var asignaciones = ViewBag.MisMaterias as List<SIARAWEB.Models.DocenteAsignatura> ?? new List<SIARAWEB.Models.DocenteAsignatura>();
}

<div class="container-fluid mt-4">
    <div class="mb-4">
        <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase;">
            <i class="bi bi-folder-check me-2"></i> MIS REQUERIMIENTOS Y TAREAS
        </h3>
        <p class="text-muted fw-bold">Consulta tus entregas por cada asignatura asignada en el ciclo escolar.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold text-center shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 py-5 text-center text-muted">
            <i class="bi bi-calendar-x display-4 d-block mb-3 opacity-50"></i>
            <h5>No hay tareas o requerimientos activos actualmente.</h5>
        </div>
    }
    else
    {
        @foreach (var task in Model)
        {
            bool vencida = DateTime.Now > task.DueDate;
            // Filtra solo las materias que coincidan con el periodo de esta tarea
            var materiasPeriodo = asignaciones
            .Where(da => da.Subject != null && da.AcademicPeriodId == task.AcademicPeriodId && da.Subject.DepartamentoId == task.DepartamentoId)
            .ToList();

            <div class="card shadow-sm border-0 rounded-4 mb-5" style="border-left: 6px solid @(vencida ? "#dc3545" : "#112d60") !important;">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-light text-dark border fw-bold">@(task.AcademicPeriod?.Name ?? "General")</span>
                            <span class="badge bg-primary">@task.PhaseType</span>
                            <span class="badge @(vencida ? "bg-danger" : "bg-success")">
                                @(vencida ? "Vencida" : "Abierta")
                            </span>
                        </div>
                        <h4 class="fw-bold mb-0" style="color: #112d60;">@task.Title</h4>
                        @if (!string.IsNullOrWhiteSpace(task.Description))
                        {
                            <small class="text-muted">@task.Description</small>
                        }
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block fw-bold">FECHA LÍMITE DE ENTREGA:</small>
                        <span class="fw-bold @(vencida ? "text-danger" : "text-dark")">
                            <i class="bi bi-clock me-1"></i> @task.DueDate.ToString("dd/MMM/yyyy HH:mm") hrs
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 bg-light bg-opacity-50">
                    <h6 class="fw-bold text-muted mb-3" style="font-size: 13px; text-transform: uppercase;">
                        <i class="bi bi-mortarboard-fill me-1"></i> TUS ASIGNATURAS EN ESTA TAREA:
                    </h6>

                    @if (!materiasPeriodo.Any())
                    {
                        <div class="alert alert-light border text-muted py-3">
                            <i class="bi bi-info-circle me-1"></i> No tienes materias asignadas en el periodo correspondiente a este requerimiento.
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var da in materiasPeriodo)
                            {
                                var subject = da.Subject!;
                                var docsSubidos = subject.Documents?.Count(d => d.DocumentTaskId == task.Id) ?? 0;
                                var tracksSubidos = subject.AcademicTrackings?.Count(t => t.DocumentTaskId == task.Id) ?? 0;
                                bool isCompleted = (task.PhaseType == "Inicial") ? (docsSubidos > 0) : (docsSubidos > 0 && tracksSubidos > 0);

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 shadow-sm border-0 rounded-3">
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <span class="badge bg-secondary">@subject.Code</span>
                                                    <span class="badge bg-light text-dark border">@da.Group</span>
                                                </div>
                                                <div class="d-flex flex-column align-items-start mb-1">
                                                    <h6 class="fw-bold text-dark mb-1">@subject.Name</h6>
                                                    <div class="d-flex gap-1 mt-1">
                                                        @if (docsSubidos > 0) {
                                                            <span class="badge bg-success" style="font-size: 9px;"><i class="bi bi-file-earmark-check"></i> DOCS OK</span>
                                                        } else {
                                                            <span class="badge bg-warning text-dark" style="font-size: 9px;"><i class="bi bi-file-earmark-x"></i> SIN DOCS</span>
                                                        }
                                                        @if (task.PhaseType != "Inicial") {
                                                            if (tracksSubidos > 0) {
                                                                <span class="badge bg-success" style="font-size: 9px;"><i class="bi bi-bar-chart-fill"></i> CALIF OK</span>
                                                            } else {
                                                                <span class="badge bg-warning text-dark" style="font-size: 9px;"><i class="bi bi-bar-chart"></i> SIN CALIF</span>
                                                            }
                                                        }
                                                    </div>
                                                </div>

                                                <div class="p-2 bg-light rounded-2 my-2" style="font-size: 12px;">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span>Evidencias PDF:</span>
                                                        <strong class="text-primary">@docsSubidos subida(s)</strong>
                                                    </div>
                                                    @if (task.PhaseType != "Inicial")
                                                    {
                                                        <div class="d-flex justify-content-between">
                                                            <span>Calificaciones:</span>
                                                            <strong class="text-success">@tracksSubidos tema(s)</strong>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="d-flex gap-2 mt-2 pt-2 border-top">
                                                <!-- Botón para subir Documentos PDF -->
                                                <a href="/Documents/Upload/@subject.Id?taskId=@task.Id" class="btn btn-sm btn-outline-primary fw-bold w-100">
                                                    <i class="bi bi-upload me-1"></i> Evidencias
                                                </a>

                                                <!-- Botón para Capturar Calificaciones (solo si no es fase inicial) -->
                                                @if (task.PhaseType != "Inicial")
                                                {
                                                    <a href="/AcademicTrackings/Capture/@subject.Id?taskId=@task.Id" class="btn btn-sm btn-outline-success fw-bold w-100">
                                                        <i class="bi bi-pencil-square me-1"></i> Calificar
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>



