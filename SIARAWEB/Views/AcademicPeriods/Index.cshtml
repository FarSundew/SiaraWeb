@model SIARAWEB.Models.PeriodConfig

@{
    ViewData["Title"] = "Configuración de Nombres de Periodos";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="mb-4">
        <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin-bottom: 4px;">
            <i class="bi bi-sliders me-2"></i> NOMBRES DEL SELECTOR DE PERIODOS
        </h3>
        <p class="text-muted fw-bold mb-0">
            Configura cómo se llaman las opciones del selector de Semestre/Periodo cuando el Jefe de Carrera agrega una nueva tarea o asigna una materia.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold text-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show fw-bold text-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0" style="border-radius: 14px; overflow: hidden;">
        <div class="card-header py-3 px-4 text-white d-flex justify-content-between align-items-center" style="background-color: #112d60;">
            <h5 class="mb-0 fw-bold" style="font-size: 15px; text-transform: uppercase;">
                <i class="bi bi-pencil-square me-2" style="color: #f4a915;"></i> Opciones del Selector de Semestre
            </h5>
            <span class="badge bg-warning text-dark fw-bold px-3 py-1">Cambio Global</span>
        </div>

        <div class="card-body p-4">
            <form asp-action="UpdateNames" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase small" style="color: #112d60;">
                            Opción 1 (Primer Semestre del Año):
                        </label>
                        <input type="text"
                               id="inputPeriodo1"
                               name="periodo1"
                               value="@Model.Periodo1"
                               class="form-control form-control-lg fw-bold"
                               style="color: #112d60; border: 2px solid #cbd5e1; border-radius: 10px;"
                               placeholder="Ej. Enero - Junio o Primer Periodo"
                               required />
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            <span class="badge bg-light text-primary border" style="cursor:pointer;" onclick="document.getElementById('inputPeriodo1').value='Enero - Junio'">Enero - Junio</span>
                            <span class="badge bg-light text-primary border" style="cursor:pointer;" onclick="document.getElementById('inputPeriodo1').value='Febrero - Junio'">Febrero - Junio</span>
                            <span class="badge bg-light text-secondary border" style="cursor:pointer;" onclick="document.getElementById('inputPeriodo1').value='Primer Periodo'">Primer Periodo</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase small" style="color: #112d60;">
                            Opción 2 (Segundo Semestre del Año):
                        </label>
                        <input type="text"
                               id="inputPeriodo2"
                               name="periodo2"
                               value="@Model.Periodo2"
                               class="form-control form-control-lg fw-bold"
                               style="color: #112d60; border: 2px solid #cbd5e1; border-radius: 10px;"
                               placeholder="Ej. Agosto - Diciembre o Julio - Diciembre"
                               required />
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            <span class="badge bg-light text-primary border" style="cursor:pointer;" onclick="document.getElementById('inputPeriodo2').value='Julio - Diciembre'">Julio - Diciembre</span>
                            <span class="badge bg-light text-primary border" style="cursor:pointer;" onclick="document.getElementById('inputPeriodo2').value='Agosto - Diciembre'">Agosto - Diciembre</span>
                            <span class="badge bg-light text-secondary border" style="cursor:pointer;" onclick="document.getElementById('inputPeriodo2').value='Segundo Periodo'">Segundo Periodo</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-uppercase small text-muted">
                        Opción Adicional / Especial (Opcional):
                    </label>
                    <input type="text"
                           name="periodoExtra"
                           value="@Model.PeriodoExtra"
                           class="form-control"
                           style="border-radius: 10px;"
                           placeholder="Dejar en blanco o escribir ej. Curso de Verano, Tercer Periodo..." />
                    <small class="text-muted">Si escribes algo aquí, también aparecerá como una tercera opción en el selector del Jefe de Carrera.</small>
                </div>

                <div class="alert alert-light border d-flex align-items-center gap-3 mb-4" style="border-radius: 10px;">
                    <i class="bi bi-info-circle-fill fs-4 text-primary"></i>
                    <div class="small text-muted">
                        Cuando el Jefe de Carrera entre a <strong>Publicar Nueva Tarea</strong> o <strong>Asignar Materia</strong>, verá los dos selectores (<strong>Semestre</strong> con estos nombres + <strong>Año</strong>) y podrá crear o seleccionar el ciclo automáticamente.
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn px-5 py-2 fw-bold shadow-sm" style="background-color: #f4a915; color: #112d60; border-radius: 8px; font-size: 15px;">
                        <i class="bi bi-check-circle-fill me-2"></i> Guardar Nombres del Selector
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
