@model IEnumerable<IGrouping<SIARAWEB.Models.AcademicPeriod, SIARAWEB.Models.DocenteAsignatura>>

@{
    ViewData["Title"] = "Expediente del Docente";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string docenteId = ViewBag.DocenteId ?? "";
}

<div class="container-fluid py-3">
    <!-- Encabezado con datos del Docente -->
    <div class="card border-0 shadow-sm mb-4 p-4 text-white" style="background: linear-gradient(135deg, #112d60 0%, #1d428a 100%); border-radius: 14px;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white text-dark fw-bold d-flex align-items-center justify-content-center me-3 shadow-sm"
                     style="width: 55px; height: 55px; font-size: 20px; color: #112d60 !important;">
                    @(string.IsNullOrEmpty(ViewBag.DocenteNombre) ? "D" : ((string)ViewBag.DocenteNombre).Substring(0, 1).ToUpper())
                </div>
                <div>
                    <div>
                        <h3 class="fw-bold mb-0">@ViewBag.DocenteNombre</h3>
                        <p class="mb-0 opacity-75">
                            <i class="bi bi-envelope me-1"></i> @ViewBag.DocenteEmail |
                            <i class="bi bi-building me-1"></i> @ViewBag.DocenteDepto
                        </p>
                    </div>
                </div>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-light fw-bold px-3 py-2" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-1"></i> Regresar al Directorio
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm border-0" style="border-radius: 12px;">
            <i class="bi bi-inbox fs-1 text-primary d-block mb-2"></i>
            <h5 class="fw-bold">Sin Asignaturas</h5>
            <p class="text-muted m-0">Este docente no tiene materias asignadas en el historial ni en el ciclo escolar vigente.</p>
        </div>
    }

    <!-- Bloques por Periodo Escolar -->
    @foreach (var grupo in Model)
    {
        var periodo = grupo.Key;
        bool esActual = periodo != null && periodo.IsActive;

        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; overflow: hidden; border-left: 6px solid @(esActual ? "#198754" : "#6c757d") !important;">
            <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2"
                 style="background-color: @(esActual ? "#112d60" : "#f8f9fa"); color: @(esActual ? "#ffffff" : "#112d60");">
                <div class="d-flex align-items-center">
                    <i class="bi @(esActual ? "bi-calendar-check-fill text-warning" : "bi-calendar3 text-muted") fs-4 me-2"></i>
                    <div>
                        <h5 class="fw-bold mb-0">@(periodo?.Name ?? "Periodo No Asignado")</h5>
                        @if (periodo != null)
                        {
                            <small class="@(esActual ? "text-light opacity-75" : "text-muted")">
                                Vigencia: @periodo.StartDate.ToString("dd/MM/yyyy") al @periodo.EndDate.ToString("dd/MM/yyyy")
                            </small>
                        }
                    </div>
                </div>
                <div>
                    @if (esActual)
                    {
                        <span class="badge px-3 py-2 fw-bold" style="background-color: #f4a915; color: #112d60; border-radius: 20px;">
                            <i class="bi bi-star-fill me-1"></i> PERIODO ACTUAL
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2" style="border-radius: 20px;">
                            <i class="bi bi-archive me-1"></i> Concluido
                        </span>
                    }
                </div>
            </div>

            <div class="card-body p-4 bg-light bg-opacity-50">
                <div class="row g-3">
                    @foreach (var asignacion in grupo)
                    {
                        var materia = asignacion.Subject;
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm p-3 hover-card" style="border-radius: 12px; background-color: #ffffff;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1" style="font-size: 11px;">
                                        @(string.IsNullOrEmpty(materia?.Code) ? "S/C" : materia.Code)
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 11px;">
                                        @(string.IsNullOrEmpty(asignacion.Group) ? "Grupo A" : asignacion.Group)
                                    </span>
                                </div>
                                <h6 class="fw-bold text-dark mb-2" style="min-height: 40px;">
                                    @(materia?.Name ?? "Asignatura sin nombre")
                                </h6>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-building me-1"></i>@(materia?.Departamento?.Name ?? "Departamento General")
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Paginador numérico -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center mt-4 mb-2">
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-md shadow-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Details" asp-route-id="@docenteId" asp-route-page="@(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link @(i == currentPage ? "fw-bold" : "")"
                               asp-action="Details"
                               asp-route-id="@docenteId"
                               asp-route-page="@i"
                               style="@(i == currentPage ? "background-color: #112d60; border-color: #112d60;" : "")">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Details" asp-route-id="@docenteId" asp-route-page="@(currentPage + 1)">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="text-center text-muted small">
            Página <strong>@currentPage</strong> de <strong>@totalPages</strong>
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid rgba(0,0,0,0.06) !important;
    }

        .hover-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.08) !important;
        }
</style>