@model SIARAWEB.ViewModels.DocenteViewModel
@{
    ViewData["Title"] = "Nuevo Docente";
}

<div class="container mt-4">
    <h2 style="color: #112d60; font-weight: 900;">NUEVO DOCENTE</h2>
    <p class="text-muted">Ingrese los datos institucionales para registrar a un nuevo docente en el sistema.</p>

    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow-sm border-top border-4" style="border-color: #112d60 !important;">
                <div class="card-header bg-white pb-0 border-0 mt-2">
                    <h5 style="color: #112d60; font-weight: bold;">DATOS DEL DOCENTE</h5>
                    <hr style="background-color: #f4a915; height: 2px; opacity: 1;" />
                </div>
                <div class="card-body">

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Name" class="control-label fw-bold" style="color: #112d60;">NOMBRE COMPLETO</label>
                                <input asp-for="Name" class="form-control" style="border-color: #112d60;" placeholder="Ej. Juan Pérez" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Email" class="control-label fw-bold" style="color: #112d60;">CORREO ELECTRÓNICO</label>
                                <input asp-for="Email" class="form-control" type="email" style="border-color: #112d60;" placeholder="ejemplo@campeche.tecnm.mx" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Rfc" class="control-label fw-bold" style="color: #112d60;">RFC</label>
                                <input asp-for="Rfc" class="form-control" style="border-color: #112d60;" placeholder="13 caracteres" maxlength="13" />
                                <span asp-validation-for="Rfc" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Curp" class="control-label fw-bold" style="color: #112d60;">CURP</label>
                                <input asp-for="Curp" class="form-control" style="border-color: #112d60;" placeholder="18 caracteres" maxlength="18" />
                                <span asp-validation-for="Curp" class="text-danger"></span>
                            </div>

                            <!-- Menú dinámico de Departamentos -->
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Departamento" class="control-label fw-bold" style="color: #112d60;">DEPARTAMENTO</label>
                                <select asp-for="Departamento" class="form-select" asp-items="ViewBag.DepartamentosLista" style="border-color: #112d60;">
                                    <option value="">Seleccione un departamento...</option>
                                </select>
                                <span asp-validation-for="Departamento" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Password" class="control-label fw-bold" style="color: #112d60;">CONTRASEÑA TEMPORAL</label>
                                <input asp-for="Password" class="form-control" type="password" style="border-color: #112d60;" placeholder="Contraseña de inicio" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="form-group d-flex justify-content-end gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">CANCELAR</a>
                            <input type="submit" value="GUARDAR Y ENVIAR" class="btn text-white fw-bold" style="background-color: #112d60;" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estructura exacta de scripts que me pegaste -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}