@model SIARAWEB.ViewModels.DocenteEditViewModel

@{
    ViewData["Title"] = "Editar Docente";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 style="color: #112d60; font-weight: 900;">EDITAR DOCENTE</h2>
    <p class="text-muted">Modifique los datos institucionales del docente.</p>

    <div class="card shadow-sm border-top border-4" style="border-color: #112d60 !important;">
        <div class="card-header bg-white pb-0 border-0 mt-2">
            <h5 style="color: #112d60; font-weight: bold;">DATOS DEL DOCENTE</h5>
            <hr style="background-color: #f4a915; height: 2px; opacity: 1;" />
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <!-- ⚠️ Oculto, pero vital para el sistema -->
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <!-- Nombre Completo -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="control-label fw-bold" style="color: #112d60;">NOMBRE COMPLETO</label>
                        <input asp-for="Name" class="form-control" style="border-color: #112d60;" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Correo Electrónico -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="control-label fw-bold" style="color: #112d60;">CORREO ELECTRÓNICO</label>
                        <input asp-for="Email" class="form-control" type="email" style="border-color: #112d60;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- RFC -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Rfc" class="control-label fw-bold" style="color: #112d60;">RFC</label>
                        <input asp-for="Rfc" class="form-control" maxlength="13" style="border-color: #112d60;" />
                        <span asp-validation-for="Rfc" class="text-danger"></span>
                    </div>

                    <!-- CURP -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Curp" class="control-label fw-bold" style="color: #112d60;">CURP</label>
                        <input asp-for="Curp" class="form-control" maxlength="18" style="border-color: #112d60;" />
                        <span asp-validation-for="Curp" class="text-danger"></span>
                    </div>

                    <!-- Departamento -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DepartamentoId" class="control-label fw-bold" style="color: #112d60;">DEPARTAMENTO</label>
                        <select asp-for="DepartamentoId" asp-items="@ViewBag.DepartamentosLista" class="form-select" style="border-color: #112d60;">
                            <option value="">Seleccione un departamento...</option>
                        </select>
                        <span asp-validation-for="DepartamentoId" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold">CANCELAR</a>
                    <button type="submit" class="btn text-white fw-bold" style="background-color: #112d60;">
                        GUARDAR CAMBIOS
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}