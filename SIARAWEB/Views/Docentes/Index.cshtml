@model IEnumerable<SIARAWEB.Models.ApplicationUser>

@{
    ViewData["Title"] = "Catálogo de Docentes";
    Layout = "_Layout";
}

<!-- Se sobreescriben estilos de bootstrap para este contenedor según tu diseño -->
<style>
    .container {
        max-width: 100% !important;
        padding: 0 !important;
    }

    main {
        padding-bottom: 0 !important;
    }
</style>

<!-- Se manda llamar tu hoja de estilos personalizada donde están tus clases 3D -->
<link rel="stylesheet" href="~/css/estilos.css" />

<div style="background-color: #f4f6f9; padding-top: 25px; padding-bottom: 40px; min-height: 100vh; width: 100%;">

    <!-- Tarjeta principal centrada -->
    <div style="margin: 0 40px; background-color: #f2f3f5; border: 2px solid #ccc; border-radius: 15px; position: relative; padding-bottom: 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">

        <!-- Botón circular rojo para salir/cerrar -->
        <a asp-controller="Home" asp-action="Index" class="btn-cerrar-rojo">&#10005;</a>

        <!-- Encabezado Institucional -->
        <div style="background-color: #112d60; color: white; text-align: center; font-weight: 900; padding: 15px; border-radius: 13px 13px 0 0; font-size: 20px; margin-bottom: 25px; text-transform: uppercase;">
            CATÁLOGO DE DOCENTES
        </div>

        <!-- Tabla de Datos -->
        <div style="padding: 0 30px;">
            <table class="tabla-dashboard" style="width: 100%; text-align: center;">
                <thead>
                    <tr>
                        <th style="width: 25%; text-align: left;">NOMBRE COMPLETO &#128269;</th>
                        <th style="width: 20%;">DEPARTAMENTO</th>
                        <th style="width: 15%;">RFC</th>
                        <th style="width: 25%;">CORREO INSTITUCIONAL</th>
                        <th style="width: 15%;">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size: 14px; text-transform: uppercase; font-weight: 900; text-align: left;">@item.Name</td>
                                <!-- ⚠️ Mostramos el nombre del departamento o un texto por defecto si está vacío -->
                                <td style="font-size: 14px; font-weight: 900;">
                                    @(item.DepartamentoId != null ? item.Departamento.Nombre : "Sin Asignar")
                                </td>
                                <td style="font-size: 14px; font-weight: 900;">@item.Rfc</td>
                                <td style="font-size: 14px; font-weight: 900;">@item.Email</td>
                                <td>
                                    <!-- Botones de íconos idénticos al diseño de Asignaturas -->
                                    <div style="display: flex; justify-content: center; gap: 15px;">
                                        <a asp-action="Edit" asp-route-id="@item.Id" style="color: black; text-decoration: none; font-size: 20px;" title="Editar">
                                            &#9998;
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" style="color: black; text-decoration: none; font-size: 20px;" title="Eliminar">
                                            &#128465;
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="padding: 30px; color: #666; font-size: 16px; font-weight: bold;">
                                No hay docentes registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Botones inferiores SIARA 3D -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 25px 30px 0 30px;">
            <a asp-controller="Home" asp-action="Index" class="btn-siara-3d" style="text-decoration: none;">SALIR</a>

            <div style="display: flex; gap: 15px;">
                <a asp-action="Create" class="btn-siara-3d" style="text-decoration: none;">AGREGAR</a>
            </div>
        </div>

    </div>
</div>