@model IEnumerable<SIARAWEB.Models.ApplicationUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<SIARAWEB.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Directorio de Docentes";
    int miDeptoId = ViewBag.MiDepartamentoId ?? 0;
    bool esJefeCarrera = User.IsInRole("JefeCarrera");
    var currentUserId = UserManager.GetUserId(User);
    string? jefeTitularId = ViewBag.JefeTitularId as string;
    bool yoSoyJefeTitular = User.IsInRole("Administrador") || (!string.IsNullOrEmpty(jefeTitularId) && currentUserId == jefeTitularId);
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 style="color: #112d60; font-weight: 900; text-transform: uppercase; margin-bottom: 0;">
                <i class="bi bi-people-fill me-2"></i> DIRECTORIO DE DOCENTES
            </h3>
            <p class="text-muted fw-bold m-0">Consulta la plantilla docente, asignaciones y comisiones de auditoría auxiliar.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary fw-bold px-3 py-2 shadow-sm" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#prestamoDocenteModal">
                <i class="bi bi-arrow-left-right me-1"></i> Préstamo de Docente
            </button>
            <a asp-action="Create" class="btn text-white fw-bold px-3 py-2 shadow-sm" style="background-color: #112d60; border-radius: 8px;">
                <i class="bi bi-person-plus-fill me-1" style="color: #f4a915;"></i> Alta de Docente
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tarjetas Informativas de Métricas -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 5px solid #112d60 !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 text-white me-3" style="background-color: #112d60;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Total Docentes Visibles</h6>
                        <h3 class="fw-bold m-0" style="color: #112d60;">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 5px solid #28a745 !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 text-white me-3 bg-success">
                        <i class="bi bi-journal-check fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Con Asignaturas</h6>
                        <h3 class="fw-bold m-0 text-success">@Model.Count(d => d.DocenteAsignaturas != null && d.DocenteAsignaturas.Any())</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 5px solid #f4a915 !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 text-white me-3" style="background-color: #f4a915;">
                        <i class="bi bi-exclamation-triangle-fill fs-4" style="color: #112d60;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Sin Asignaturas</h6>
                        <h3 class="fw-bold m-0" style="color: #112d60;">@Model.Count(d => d.DocenteAsignaturas == null || !d.DocenteAsignaturas.Any())</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Principal de Docentes -->
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #112d60; color: #ffffff;">
                        <tr>
                            <th class="py-3 px-4">Docente</th>
                            <th class="py-3 px-4">Correo Institucional</th>
                            <th class="py-3 px-4 text-center">Asignaturas</th>
                            @if (esJefeCarrera)
                            {
                                <th class="py-3 px-4 text-center">Rol Auxiliar</th>
                            }
                            <th class="py-3 px-4 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="@(esJefeCarrera ? 5 : 4)" class="text-center py-4 text-muted">
                                    No se encontraron docentes registrados.
                                </td>
                            </tr>
                        }

                        @foreach (var docente in Model)
                        {
                            int cantidadMaterias = docente.DocenteAsignaturas?.Count ?? 0;
                            bool esDeMiCarrera = docente.DepartamentoId == miDeptoId;
                            bool esRevisor = await UserManager.IsInRoleAsync(docente, "JefeCarrera");
                            bool esAdmin = await UserManager.IsInRoleAsync(docente, "Administrador") || await UserManager.IsInRoleAsync(docente, "JefeGeneral");
                            bool esYo = docente.Id == currentUserId;
                            bool esJefeTitular = (!string.IsNullOrEmpty(jefeTitularId) && docente.Id == jefeTitularId)
                                                 || (docente.Departamento != null && docente.Departamento.HeadOfDepartmentId == docente.Id);

                            <tr>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3 text-white fw-bold d-flex align-items-center justify-content-center"
                                             style="width: 40px; height: 40px; background-color: @(esDeMiCarrera ? "#112d60" : "#6c757d"); border-radius: 50%; font-size: 14px;">
                                            @(string.IsNullOrEmpty(docente.FullName) ? "D" : docente.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@(string.IsNullOrEmpty(docente.FullName) ? docente.UserName : docente.FullName)</span>
                                            @if (esDeMiCarrera)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size: 11px;">
                                                    Adscrito a la Academia
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 11px;">
                                                    Docente de Apoyo (@(docente.Departamento?.Code ?? "Otra Carrera"))
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="px-4 text-muted">
                                    <i class="bi bi-envelope me-1"></i>@docente.Email
                                </td>

                                <td class="px-4 text-center">
                                    @if (cantidadMaterias > 0)
                                    {
                                        <span class="badge bg-success text-white px-3 py-2" style="border-radius: 20px; font-size: 13px;">
                                            <i class="bi bi-book me-1"></i> @cantidadMaterias materia(s)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2" style="border-radius: 20px; font-size: 13px;">
                                            <i class="bi bi-exclamation-circle me-1"></i> Sin materias
                                        </span>
                                    }
                                </td>

                                <!-- COLUMNA ROL AUXILIAR (Solo visible para Jefe de Carrera) -->
                                @if (esJefeCarrera)
                                {
                                    <td class="px-4 text-center">
                                        @if (esAdmin)
                                        {
                                            <span class="badge bg-danger text-white py-2 px-3" style="font-size: 12px; border-radius: 20px;" title="Administrador del sistema protegido">
                                                <i class="bi bi-shield-fill me-1"></i> Administrador
                                            </span>
                                        }
                                        else if (esJefeTitular)
                                        {
                                            <span class="badge bg-success text-white py-2 px-3" style="font-size: 12px; border-radius: 20px;" title="Jefe de Carrera Titular (Inmune a revocación)">
                                                <i class="bi bi-star-fill me-1"></i> Jefe Titular
                                            </span>
                                        }
                                        else if (esDeMiCarrera)
                                        {
                                            @if (esRevisor)
                                            {
                                                <div class="d-flex flex-column align-items-center gap-2">
                                                    <span class="badge bg-primary text-white px-3 py-2" style="font-size: 12px; border-radius: 20px;">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Revisor Activo
                                                    </span>
                                                    @if (yoSoyJefeTitular && !esYo)
                                                    {
                                                        <form asp-action="ToggleReviewerRole" method="post" class="d-inline m-0">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="docenteId" value="@docente.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-3 fw-bold"
                                                                    onclick="return confirm('¿Deseas revocar los permisos de revisión a este docente?');"
                                                                    style="font-size: 11px; border-radius: 6px;">
                                                                <i class="bi bi-x-lg me-1"></i> Revocar
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                @if (yoSoyJefeTitular)
                                                {
                                                    <form asp-action="ToggleReviewerRole" method="post" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="docenteId" value="@docente.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-primary py-1 px-3 fw-bold"
                                                                onclick="return confirm('¿Deseas comisionar a este docente como revisor auxiliar? Podrá dictaminar evidencias de la carrera.');"
                                                                style="font-size: 11px; border-radius: 6px;">
                                                            <i class="bi bi-plus-circle me-1"></i> Comisionar
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-white py-2 px-3" style="font-size: 12px; border-radius: 20px;">
                                                        <i class="bi bi-person me-1"></i> Docente
                                                    </span>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark text-white py-2 px-3" style="font-size: 12px; border-radius: 20px;" title="Solo puedes comisionar a docentes adscritos a tu academia">
                                                <i class="bi bi-ban me-1"></i> No Elegible
                                            </span>
                                        }
                                    </td>
                                }

                                <td class="px-4 text-end">
                                    <a asp-action="Details" asp-route-id="@docente.Id" class="btn btn-sm text-white px-3 py-1" style="background-color: #112d60; border-radius: 8px;">
                                        <i class="bi bi-eye me-1"></i> Ver Carga
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal de Préstamo de Docente Interdepartamental -->
    <div class="modal fade" id="prestamoDocenteModal" tabindex="-1" aria-labelledby="prestamoDocenteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; overflow: hidden;">
                <div class="modal-header text-white" style="background-color: #112d60;">
                    <div>
                        <h5 class="modal-title fw-bold" id="prestamoDocenteModalLabel">
                            <i class="bi bi-arrow-left-right me-2"></i> Préstamo de Docente Interdepartamental
                        </h5>
                        <small class="opacity-75">Asigna una asignatura de tu carrera a un profesor adscrito a otro departamento</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="AssignTeacher" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #112d60;">Docente a Solicitar en Préstamo</label>
                            <select class="form-select" name="docenteId" required>
                                <option value="">-- Selecciona el Docente --</option>
                                @if (ViewBag.TodosDocentes != null)
                                {
                                    foreach (var d in (IEnumerable<SIARAWEB.Models.ApplicationUser>)ViewBag.TodosDocentes)
                                    {
                                        string deptoDocente = d.Departamento?.Code ?? d.Departamento?.Name ?? "Sin Depto";
                                        bool esExterno = d.DepartamentoId != miDeptoId;
                                        <option value="@d.Id">
                                            @d.FullName (@deptoDocente) @(esExterno ? "★ Externo" : "(Adscrito)")
                                        </option>
                                    }
                                }
                            </select>
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-info-circle me-1"></i> Puedes seleccionar tanto profesores de tu carrera como de otros departamentos.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #112d60;">Materia a Asignar</label>
                            <select class="form-select" name="subjectId" required>
                                <option value="">-- Selecciona una Materia --</option>
                                @if (ViewBag.MisAsignaturas != null)
                                {
                                    foreach (var sub in (IEnumerable<SIARAWEB.Models.Subject>)ViewBag.MisAsignaturas)
                                    {
                                        <option value="@sub.Id">@sub.Code - @sub.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-bold" style="color: #112d60;">Semestre / Periodo</label>
                                <select class="form-select" name="semestre" required>
                                    @{
                                        var opcionesPrestamo = SIARAWEB.Models.PeriodConfig.Load().GetOpciones();
                                        bool defaultSeg = DateTime.Now.Month > 6;
                                    }
                                    @for (int i = 0; i < opcionesPrestamo.Count; i++)
                                    {
                                        string op = opcionesPrestamo[i];
                                        bool sel = (i == 0 && !defaultSeg) || (i == 1 && defaultSeg);
                                        <option value="@op" selected="@sel">@op</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold" style="color: #112d60;">Año</label>
                                <select class="form-select" name="anio" required>
                                    @{
                                        int anioBase = DateTime.Now.Year;
                                        for (int y = anioBase; y <= anioBase + 2; y++)
                                        {
                                            <option value="@y" selected="@(y == anioBase)">@y</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" style="color: #112d60;">Grupo</label>
                                <input type="text" class="form-control" name="group" placeholder="Ej. Grupo A" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" style="color: #112d60;">Turno</label>
                                <select class="form-select" name="turno" required>
                                    <option value="Matutino">Matutino</option>
                                    <option value="Vespertino">Vespertino</option>
                                    <option value="Mixto">Mixto</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn text-white fw-bold" style="background-color: #112d60;">
                            <i class="bi bi-check-lg me-1"></i> Asignar Carga en Préstamo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>