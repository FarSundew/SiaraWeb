@model SIARAWEB.Models.Departamento

@{
    ViewData["Title"] = "Eliminar Departamento";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="text-danger fw-bold" style="font-weight: 900;">ELIMINAR DEPARTAMENTO</h2>
    <h5 class="text-muted">¿Está seguro de que desea eliminar este departamento? <strong class="text-danger">Esta acción no se puede deshacer.</strong></h5>

    <div class="card shadow-sm border-top border-4 mt-3" style="border-color: #dc3545 !important;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold" style="color: #112d60;">
                    Departamento a eliminar:
                </dt>
                <dd class="col-sm-9 fw-bold fs-5 text-danger">
                    @Model.Nombre
                </dd>
            </dl>

            <form asp-action="Delete" class="d-flex justify-content-end gap-3 mt-4">
                <!-- ⚠️ Mandamos el ID al método POST para que sepa cuál borrar -->
                <input type="hidden" asp-for="Id" />

                <a asp-action="Index" class="btn btn-outline-secondary fw-bold">CANCELAR</a>
                <button type="submit" class="btn btn-danger fw-bold">
                    🗑 SÍ, ELIMINAR DEPARTAMENTO
                </button>
            </form>
        </div>
    </div>
</div>