@page
@model EmailModel
@{
    ViewData["Title"] = "Gestionar Correo Electrónico";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3 style="color: #112d60; font-weight: bold; margin-bottom: 20px;">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-body p-4">
                <form id="email-form" method="post">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="form-floating mb-3 input-group">
                            <input asp-for="Email" class="form-control" placeholder="Correo actual" disabled />
                            <div class="input-group-append">
                                <span class="h-100 input-group-text text-success font-weight-bold">✓ Confirmado</span>
                            </div>
                            <label asp-for="Email" class="form-label">Correo Electrónico Actual</label>
                        </div>
                    }
                    else
                    {
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Correo actual" disabled />
                            <label asp-for="Email" class="form-label">Correo Electrónico Actual</label>
                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link px-0 text-decoration-none">Enviar correo de verificación</button>
                        </div>
                    }

                    <div class="form-floating mb-4">
                        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Nuevo correo" />
                        <label asp-for="Input.NewEmail" class="form-label">Nuevo Correo Electrónico</label>
                        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                    </div>

                    <div class="text-end">
                        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-lg text-white" style="background-color: #112d60; border-radius: 8px; padding: 10px 30px;">
                            <i class="bi bi-envelope-paper me-2"></i> Cambiar Correo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}