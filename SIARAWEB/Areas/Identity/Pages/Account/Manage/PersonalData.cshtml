@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Datos Personales";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 style="color: #112d60; font-weight: bold; margin-bottom: 20px;">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-body p-4">
                <p>Tu cuenta contiene datos personales que has proporcionado a la plataforma SIARA. Esta sección te permite descargar una copia de tus registros o solicitar la eliminación definitiva de tu cuenta.</p>

                <div class="alert alert-warning border-0 shadow-sm my-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5 me-2"></i>
                    <strong>Advertencia:</strong> Eliminar tus datos borrará de forma permanente tu cuenta y accesos al sistema. Esta acción no se puede deshacer.
                </div>

                <div class="d-flex gap-3 mt-4">
                    <form id="download-data" asp-page="DownloadPersonalData" method="post">
                        <button class="btn text-white" type="submit" style="background-color: #112d60; border-radius: 8px; padding: 10px 20px;">
                            <i class="bi bi-download me-2"></i> Descargar Mis Datos
                        </button>
                    </form>
                    <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger" style="border-radius: 8px; padding: 10px 20px;">
                        <i class="bi bi-trash me-2"></i> Eliminar Cuenta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}