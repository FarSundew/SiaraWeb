@page
@model SIARAWEB.Areas.Identity.Pages.Account.Manage.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Habilitar autenticador";
}

<style>
    /* Ajusta los valores (px) según necesites */
    .qr-code {
        max-width: 260px;
        max-height: 260px;
        width: auto;
        height: auto;
        display: block;
    }
</style>

<h2>Habilitar autenticador</h2>

<p>Escanea este código QR con tu app de autenticador (Google Authenticator, Authy...)</p>

@if (Model.QrCodeImageUrl != null)
{
    <img src="@Model.QrCodeImageUrl"
         alt="QR Code"
         class="qr-code img-fluid" />
}

<p>Clave manual: <strong>@Model.SharedKey</strong></p>

<form method="post">
    <div class="form-group">
        <label asp-for="Input.Code"></label>
        <input asp-for="Input.Code" class="form-control" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Verificar y habilitar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
